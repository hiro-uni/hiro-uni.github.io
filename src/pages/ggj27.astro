---
import "../styles/ggj27-page.css";
import { Image } from "astro:assets";
import logo from "../assets/ggj27/ggj27_logo.png";
import unity from "../assets/ggj27/unity.png";
import gray from "../assets/ggj27/gray.png";
import godot from "../assets/ggj27/godotten.png";
const eventData = {
  "@context": "https://schema.org",
  "@type": "Event",
  "@id": "https://hiro-uni.github.io/ggj27/#event",
  name: "Global Game Jam 2027 瀬戸内会場 in 広島",
  description:
    "ゲーム制作が初めてでも、ひとりでも。仲間と共通のテーマからゲームをつくる48時間のイベント。広島工業大学で開催。参加無料。",
  url: "https://hiro-uni.github.io/ggj27/",
  startDate: "2027-01-29T17:00:00+09:00",
  endDate: "2027-01-31T19:00:00+09:00",
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: {
    "@type": "Place",
    name: "広島工業大学 五日市キャンパス 新4号館 4階418号室 (HIT Innovation Lab)",
    address: {
      "@type": "PostalAddress",
      streetAddress: "三宅2丁目1-1 新4号館 4階418号室",
      addressLocality: "広島市佐伯区",
      addressRegion: "広島県",
      postalCode: "731-5143",
      addressCountry: "JP",
    },
  },
  image: [
    "https://hiro-uni.github.io/ggj27/_astro/ggj27_logo.nDSZfTUd_Z2k4ygh.webp",
  ],
  isAccessibleForFree: true,
  offers: {
    "@type": "Offer",
    price: 0,
    priceCurrency: "JPY",
    url: "https://hirouni.connpass.com/event/408904/",
  },
  organizer: [
    {
      "@type": "Organization",
      name: "広島工業大学 IoT・AI・データサイエンス教育研究推進センター",
    },
    {
      "@type": "Organization",
      name: "広島Unity勉強会",
      url: "https://hiro-uni.github.io/",
    },
  ],
  inLanguage: "ja",
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GGJ 2027 瀬戸内会場 in 広島｜初めてのゲームづくりを、仲間と。</title>
    <meta
      name="description"
      content="ゲーム制作が初めてでも、ひとりでも。2027年1月29日〜31日、広島工業大学で仲間とゲームをつくる48時間。参加無料。16歳以上（高校生を含む）、プロ・アマ問わず。Global Game Jam 2027 瀬戸内会場 in 広島の参加案内。"
    />
    <link rel="canonical" href="https://hiro-uni.github.io/ggj27/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      property="og:title"
      content="GGJ 2027 瀬戸内会場 in 広島｜初めてでも、ひとりでも。"
    />
    <meta
      property="og:description"
      content="仲間とゲームをつくる48時間。2027年1月29日〜31日・広島工業大学・参加無料。"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://hiro-uni.github.io/ggj27/" />
    <meta
      property="og:image"
      content="https://hiro-uni.github.io/ggj27/assets/jam/hero-hiroshima-1024.webp"
    />
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="preload"
      href="/ggj27/assets/mochiy-pop-one-hero.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <script type="application/ld+json" set:html={JSON.stringify(eventData)} />
  </head>
  <body>
    <a class="skip" href="#main">
      本文へスキップ
    </a>
    <header class="site-header" inert aria-hidden="true">
      <a class="wordmark" href="#top" aria-label="GGJ 2027 トップ">
        GGJ<span>27</span>
      </a>
      <nav aria-label="メインナビゲーション">
        <a href="#about">GGJとは</a>
        <a href="#info">開催概要</a>
        <a href="#faq">FAQ</a>
        <a href="#english" lang="en">
          English
        </a>
        <a class="nav-entry" href="#entry">
          参加する！
        </a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <section class="hero" id="top" tabindex="-1" aria-labelledby="hero-title">
        <div class="hero-visual">
          <img
            class="hero-photo"
            src="/ggj27/assets/jam/hero-hiroshima-1024.webp"
            srcset="/ggj27/assets/jam/hero-hiroshima-640.webp 640w, /ggj27/assets/jam/hero-hiroshima-1024.webp 1024w"
            sizes="100vw"
            alt="過去のGlobal Game Jam 広島会場（広島工業大学）の様子"
            width="1024"
            height="768"
            fetchpriority="high"
            decoding="async"
          />
          <div class="hero-shade" aria-hidden="true"></div>
          <div class="hero-content">
            <a
              class="hero-brand"
              href="#top"
              aria-label="Global Game Jam 2027 瀬戸内会場 in 広島"
            >
              <Image
                src={logo}
                alt="グローバルゲームジャム2027 瀬戸内会場 in 広島"
                width="800"
                height="248"
                loading="eager"
                decoding="async"
              />
            </a>
            <a class="hero-language" href="#english" lang="en">
              English guide ↗
            </a>
            <h1 class="hero-title" id="hero-title">
              <span class="sr-only">
                Global Game Jam 2027 瀬戸内会場 in 広島。{" "}
              </span>
              <span>はじまるよ！！</span>
              <span>
                <b class="hero-digits">48</b>時間！！
              </span>
            </h1>
            <p class="hero-message">
              <strong>初めてでも、ひとりでも。</strong>
              <br />
              仲間とゲームをつくる週末へ。
            </p>
            <a class="hero-inline-link" href="#about">
              ゲームジャムってなに？ ↓
            </a>
          </div>
          <p class="photo-notice">
            過去のGlobal Game Jam 広島会場（広島工業大学）の様子です。
          </p>
        </div>
        <div class="hero-details">
          <div>
            <p class="hero-date">
              <time datetime="2027-01-29">2027.1.29</time>
              <span>—</span>
              <time datetime="2027-01-31">1.31</time>
            </p>
            <p class="hero-venue">広島工業大学</p>
          </div>
          <div class="hero-action">
            <a class="button button-primary" href="#entry">
              参加案内を確認する <span aria-hidden="true">↗</span>
            </a>
            <p>16歳以上 · プロ・アマ問わず · connpassで受付中</p>
          </div>
        </div>
        <div class="hero-band">
          <strong>参加無料</strong>
          <strong>48時間常時オープン</strong>
          <span>ゲーム制作未経験・ひとり参加歓迎</span>
        </div>
      </section>
      <section
        class="section px-6 py-16 md:py-24 welcome"
        aria-labelledby="welcome-title"
      >
        <div class="section-heading">
          <h2 id="welcome-title">
            「やってみたい」が、
            <br />
            参加する理由になる。
          </h2>
          <p>
            <strong>
              ゲームを完成させた経験も、
              <br />
              一緒に参加する友だちも、なくて大丈夫。
            </strong>
          </p>
        </div>
        <div class="welcome-grid">
          <article>
            <h3>初めてのゲームづくりに。</h3>
            <p>
              UnityやUnreal
              Engineを学び始めた人も、これから触ってみたい人も。手を動かして、試して、ゲームができていく面白さを味わってみよう。
            </p>
          </article>
          <article>
            <h3>プログラム以外の「好き」も。</h3>
            <p>
              <strong>絵、音楽、物語、遊びのアイデア。</strong>
              ゲームづくりには、いろんな出番があります。好きなことや得意なことを、気軽に持ち寄ってみてください。
            </p>
          </article>
          <article>
            <h3>ひとりで来て、仲間に出会う。</h3>
            <p>
              <strong>ひとりでの参加も大歓迎。</strong>
              学生も、現役の開発者も、まずはアイデアを話すところから。チームの組み方は、募集案内でお知らせします。
            </p>
          </article>
        </div>
        <a class="text-link" href="#faq">
          初めての「気になる」をチェック ↓
        </a>
        <figure
          class="character-showcase showcase-right"
          data-engine="unity"
          aria-label="UNITY キャラクター"
        >
          <figcaption>
            <b class="character-engine">UNITY</b>
            <span class="character-name">Otori Kohaku / Unity-chan</span>
          </figcaption>
          <Image
            class="showcase-image"
            src={unity}
            alt="Otori Kohaku / Unity-chan"
            width="520"
            height="735"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </section>
      <section
        class="section px-6 py-16 md:py-24 about"
        id="about"
        tabindex="-1"
        aria-labelledby="about-title"
      >
        <div class="split-layout">
          <div>
            <Image
              class="event-logo"
              src={logo}
              alt="グローバルゲームジャム2027 瀬戸内会場 in 広島"
              width="800"
              height="248"
              loading="lazy"
              decoding="async"
            />
            <h2 id="about-title">
              ゲームジャムは、
              <br />
              一緒につくる48時間。
            </h2>
            <p class="lead">
              同じテーマから、
              <br />
              まだない「あそび」を生み出そう。
            </p>
            <p>
              <strong>
                Global Game
                Jam（GGJ）は、世界各地の参加者が共通のテーマからゲームをつくるイベント。
              </strong>
              広島でも、その場で出会った仲間と一緒にゲームをつくります。
            </p>
            <p>
              「ジャム」は、音楽のジャムセッションみたいに、アイデアや得意なことを持ち寄ること。完成度を競うより、一緒に考えて、つくって、遊ぶ時間を楽しもう。
            </p>
          </div>
          <figure class="editorial-photo">
            <img
              src="/ggj27/assets/jam/about-hiroshima-1024.webp"
              srcset="/ggj27/assets/jam/about-hiroshima-640.webp 640w, /ggj27/assets/jam/about-hiroshima-1024.webp 1024w"
              sizes="(min-width: 800px) 45vw, 100vw"
              alt="過去のGlobal Game Jam 広島会場での作品発表の様子"
              width="1024"
              height="768"
              loading="lazy"
              decoding="async"
            />
            <figcaption>過去の広島会場での発表の様子</figcaption>
          </figure>
        </div>
        <figure
          class="character-showcase showcase-left"
          data-engine="unreal"
          aria-label="UNREAL ENGINE キャラクター"
        >
          <figcaption>
            <b class="character-engine">
              UNREAL<span>ENGINE</span>
            </b>
            <span class="character-name">Gray-chan</span>
          </figcaption>
          <Image
            class="showcase-image"
            src={gray}
            alt="Gray-chan"
            width="520"
            height="735"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </section>
      <section
        class="section px-6 py-16 md:py-24 process"
        id="experience"
        tabindex="-1"
        aria-labelledby="process-title"
      >
        <h2 id="process-title">
          出会って、つくって、
          <br class="mobile-only" />
          遊んでみる。
        </h2>
        <p class="section-intro">
          <strong>48時間で体験する、ゲームづくりの流れ。</strong>
        </p>
        <ol role="list" class="process-list">
          <li>
            <span class="step-number" aria-hidden="true">
              01
            </span>
            <h3>出会う・考える</h3>
            <p>
              テーマを聞いたら、自己紹介とアイデア交換。得意なことも、やってみたいことも、まずは話してみよう。
            </p>
          </li>
          <li>
            <span class="step-number" aria-hidden="true">
              02
            </span>
            <h3>つくる・試す</h3>
            <p>
              描く、組む、鳴らす。役割を分けて、さっそく手を動かそう。小さくても、遊べるゲームを目指してみよう。
            </p>
          </li>
          <li>
            <span class="step-number" aria-hidden="true">
              03
            </span>
            <h3>遊ぶ・共有する</h3>
            <p>
              できたゲームを見せ合って、遊んで、感想を交換。「次はこんなのをつくりたい！」が見つかるかも。
            </p>
          </li>
        </ol>
        <p class="note">
          当日の流れやチームの組み方は、募集案内をチェックしてね。
        </p>
        <a class="button button-outline" href="#entry">
          参加までの流れを見る <span aria-hidden="true">→</span>
        </a>
        <figure
          class="character-showcase showcase-right"
          data-engine="godot"
          aria-label="GODOT キャラクター"
        >
          <figcaption>
            <b class="character-engine">
              GODOT<span>engine</span>
            </b>
            <span class="character-name">Godot character</span>
          </figcaption>
          <Image
            class="showcase-image"
            src={godot}
            alt="Godot character"
            width="520"
            height="735"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </section>
      <section
        class="section px-6 py-16 md:py-24 info"
        id="info"
        tabindex="-1"
        aria-labelledby="info-title"
      >
        <div class="split-layout">
          <div>
            <h2 id="info-title">
              週末の予定に、
              <br />
              ゲームづくりを。
            </h2>
            <p class="section-intro">
              広島で会って、一緒につくる。
              <br />
              <strong>高校生・大学生から社会人まで、</strong>
              <br />
              ゲームづくりに興味のある人へ。
            </p>
            <a class="text-link" href="#english" lang="en">
              Event information in English ↗
            </a>
          </div>
          <dl class="info-table">
            <div>
              <dt>イベント</dt>
              <dd>
                Global Game Jam 2027
                <br />
                瀬戸内会場 in 広島
              </dd>
            </div>
            <div>
              <dt>開催日</dt>
              <dd>
                <strong>2027年1月29日（金）〜31日（日）</strong>
                <span>
                  会場は48時間オープン。開始・終了の時刻は、募集案内でチェックしてください。
                </span>
              </dd>
            </div>
            <div>
              <dt>会場</dt>
              <dd>
                <strong>広島工業大学</strong>
                <span>https://hirouni.connpass.com/event/408904/</span>
              </dd>
            </div>
            <div>
              <dt>参加費</dt>
              <dd>
                <strong>無料</strong>
              </dd>
            </div>
            <div>
              <dt>参加対象者</dt>
              <dd>
                <strong>16歳以上（高校生を含む）、プロ・アマ問わず</strong>
                <span class="eligibility-note">
                  ※16歳、17歳の方は保護者同伴でのご参加が必須となります。
                </span>
              </dd>
            </div>
            <div>
              <dt>主催</dt>
              <dd>
                広島工業大学 IoT・AI・データサイエンス教育研究推進センター
                <br />
                広島Unity勉強会
              </dd>
            </div>
          </dl>
        </div>
      </section>
      <section
        class="section px-6 py-16 md:py-24 faq"
        id="faq"
        tabindex="-1"
        aria-labelledby="faq-title"
      >
        <div class="split-layout">
          <div>
            <h2 id="faq-title">
              初めての、不安を
              <br />
              少しずつ。
            </h2>
            <p class="section-intro">参加する前に、気になること。</p>
          </div>
          <div class="faq-list">
            <details>
              <summary>
                ゲームをつくったことがなくても大丈夫？
                <span aria-hidden="true">＋</span>
              </summary>
              <p>
                「ゲームをつくってみたい」があれば大歓迎。絵、音楽、企画、シナリオなど、
                <strong>
                  プログラミング以外にも、いろんな関わり方があります。
                </strong>
                事前の講習やサポートについては、募集案内をチェックしてください。
              </p>
              <p>
                雰囲気を知りたい人は、
                <strong>
                  ゲームジャム高梁のコミュニティ動画も見てみてね。
                </strong>
                事前勉強会やイベントの様子をのぞいてみよう。
                <br />
                <a
                  class="text-link"
                  href="https://www.youtube.com/@gjtakahashi"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  ゲームジャム高梁の動画を見る ↗
                  <span class="sr-only">（新しいタブで開きます）</span>
                </a>
                <br />
                <a
                  class="text-link"
                  href="https://gjtakahashi.okayamaunity.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  ゲームジャム高梁のサイトを見る ↗
                  <span class="sr-only">（新しいタブで開きます）</span>
                </a>
              </p>
            </details>
            <details>
              <summary>
                ひとりで行っても大丈夫？<span aria-hidden="true">＋</span>
              </summary>
              <p>
                <strong>ひとりでの参加も大歓迎。</strong>
                その場で出会う人とアイデアを話すのも、ゲームジャムの楽しみのひとつ。チームの組み方は、募集案内でお知らせします。
              </p>
            </details>
            <details>
              <summary>
                AIは使えますか？<span aria-hidden="true">＋</span>
              </summary>
              <p>
                <strong>生成AIも使えます！</strong>
                ただし、著作権・知的財産権など、GGJの既存ルールを守って利用してください。
                <br />
                <a
                  class="text-link"
                  href="https://globalgamejam.org/news/global-game-jam-artificial-intelligence-policy"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  詳しくはGGJ公式AIポリシー（英語）へ ↗
                  <span class="sr-only">（新しいタブで開きます）</span>
                </a>
              </p>
            </details>
            <details>
              <summary>
                何を持っていけばいい？<span aria-hidden="true">＋</span>
              </summary>
              <p>
                いつも使っているパソコンと電源、制作ツールを持ってきてください。機材の貸し出しや会場の設備、ネット環境は、募集案内でチェックできます。
              </p>
            </details>
            <details>
              <summary>
                高校生・未成年でも参加できる？<span aria-hidden="true">＋</span>
              </summary>
              <p>
                対象は
                <strong>16歳以上（高校生を含む）、プロ・アマ問わず</strong>
                です。
                <strong>
                  16歳、17歳の方は保護者同伴でのご参加が必須となります。
                </strong>
                夜間の参加ルールなど、ほかの条件も募集案内でチェックしてください。
              </p>
            </details>
            <details>
              <summary>
                48時間ずっとつくらないとダメ？<span aria-hidden="true">＋</span>
              </summary>
              <p>
                会場は48時間オープンの予定ですが、ずっと頑張り続けなくて大丈夫。無理せず、休憩も大切に。途中参加・退出や宿泊、夜間利用のルールは、募集案内でお知らせします。
              </p>
            </details>
            <details>
              <summary>
                留学生や海外出身の友達と一緒に参加できる？
                <span aria-hidden="true">＋</span>
              </summary>
              <p>
                ゲームづくりに興味があれば、留学生や海外出身の方もぜひ。英語については山根信二さんによるサポートが可能です。
              </p>
            </details>
          </div>
        </div>
      </section>
      <section
        class="section px-6 py-16 md:py-24 mc"
        id="mc"
        tabindex="-1"
        aria-labelledby="mc-title"
      >
        <div class="mc-heading">
          <h2 id="mc-title">解説者・司会進行</h2>
          <p class="section-intro">
            ゲームジャムの背景や楽しみ方を伝えながら、イベントの進行を務めます。
          </p>
        </div>
        <div class="mc-layout">
          <img
            class="mc-photo"
            src="/ggj27/assets/shinji-yamane.jpg"
            alt="解説者・司会進行 山根 信二さん"
            width="600"
            height="600"
            loading="lazy"
            decoding="async"
          />
          <div class="mc-content">
            <div class="mc-identity">
              <h3 class="mc-name">
                山根 信二<span>さん</span>
              </h3>
              <ul role="list" class="mc-roles" aria-label="肩書き">
                <li>安田女子大学 教員</li>
                <li>NPO法人IGDA日本 理事</li>
              </ul>
            </div>
            <div class="mc-profile">
              <p>
                <strong>安田女子大学教員。</strong>
                日本で一番ゲーム開発者との共著論文が多い大学研究者(2014年調べ)。岩手県立大学、国際大学GLOCOM、青山学院大学、岡山理科大学、東京国際工科専門職大学などを経て現職。NPO法人IGDA日本で理事を兼務。
              </p>
              <p>
                これまでに情報処理学会全国大会優秀賞、情報教育シンポジウム最優秀論文賞、大都会アワードなど受賞。
              </p>
              <p>
                監訳書にセリア・ホデント著『はじめて学ぶ ビデオゲームの心理学:
                脳のはたらきとユーザー体験（UX）』(2022)、共著書に『ゲーム障害再考:
                嗜癖か、発達障害か、それとも大人のいらだちか』(2023)など。2020年1月に日本語で初めてのゲームジャム紹介記事を書き、それ以来ゲームジャムについての報告や論文を執筆している。
              </p>
              <p>
                グローバルゲームジャム2026 瀬戸内会場 in
                広島では、全編を通して解説者・司会進行を務める。
              </p>
            </div>
          </div>
        </div>
