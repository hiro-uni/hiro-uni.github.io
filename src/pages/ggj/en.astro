---
import "../../styles/ggj27-page.css";
import { Image } from "astro:assets";
import setouchiLogo from "../../assets/ggj27/ggj_setouchi_logo.png";
import unity from "../../assets/ggj27/unity.png";
import gray from "../../assets/ggj27/gray.png";
import godot from "../../assets/ggj27/godotten.png";
import { worldPlaces } from "../../scripts/ggj27-world-places.js";
import GgjPastThemes from "../../components/GgjPastThemes.astro";
import GgjCarouselControls from "../../components/GgjCarouselControls.astro";
import GgjFaq from "../../components/GgjFaq.astro";
import faqEntries from "../../data/ggj-faq-en.js";
import "../../styles/ggj27-sections.css";
import "../../styles/ggj27-refresh.css";

// Descriptions and destinations: https://globalgamejam.org/group/31042/games
const pastGames = [
  {
    title: "Kackun Packun",
    genre: "Puzzle",
    description:
      "Connect matching facial expressions until only one remains—a puzzle game using masks and drag-and-drop mechanics.",
    image: "kakkun.png",
    url: "https://globalgamejam.org/games/2026/kackun-packskatsukunhatsukun-0",
  },
  {
    title: "Narikiri Escape Game",
    genre: "Escape Game",
    description:
      "Put on rabbit and cow masks to see the world from an animal’s perspective, and find your way out of the maze before the clock strikes 12.",
    image: "narikiri.png",
    url: "https://globalgamejam.org/games/2026/narikirituochukemu-9",
  },
  {
    title: "Baikin Damashii (Germ Spirit)",
    genre: "Action",
    description:
      "Mask yourself with tiny viruses and fight to survive against the odds.",
    image: "baikin-damashi.png",
    url: "https://globalgamejam.org/games/2026/peijunhun-4",
  },
];

const eventData = {
  "@context": "https://schema.org",
  "@type": "Event",
  "@id": "https://hiro-uni.github.io/ggj/en/#event",
  name: "Global Game Jam 2027 Hiroshima (Setouchi Site)",
  description:
    "A 48-hour game-making event for international residents, students, beginners, and creators in Hiroshima. Make a game from scratch around a shared global theme at Hiroshima Institute of Technology. Free admission, with on-site English support.",
  url: "https://hiro-uni.github.io/ggj/en/",
  startDate: "2027-01-29T17:00:00+09:00",
  endDate: "2027-01-31T19:00:00+09:00",
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: {
    "@type": "Place",
    name: "HIT Innovation Lab, Room 418, 4F, New Building 4, Hiroshima Institute of Technology, Itsukaichi Campus",
    address: {
      "@type": "PostalAddress",
      streetAddress: "2-1-1 Miyake, New Building 4, 4F Room 418",
      addressLocality: "Saeki-ku, Hiroshima",
      addressRegion: "Hiroshima",
      postalCode: "731-5143",
      addressCountry: "JP",
    },
  },
  image: [
    "https://hiro-uni.github.io/ggj27/assets/jam/hero-hiroshima-1024.webp",
  ],
  isAccessibleForFree: true,
  performer: {
    "@type": "Person",
    name: "Shinji Yamane",
  },
  offers: {
    "@type": "Offer",
    price: 0,
    priceCurrency: "JPY",
    url: "https://hirouni.connpass.com/event/408904/",
    validFrom: "2026-10-30T12:31:00+09:00",
    availability: "https://schema.org/InStock",
  },
  organizer: [
    {
      "@type": "Organization",
      name: "Hiroshima Institute of Technology Center for IoT, AI and Data Science Education and Research",
      url: "https://www.it-hiroshima.ac.jp/about/gp/center/iot.html",
    },
    {
      "@type": "Organization",
      name: "Hiroshima Unity Study Group",
      url: "https://hiro-uni.github.io/",
    },
  ],
  inLanguage: ["en", "ja"],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
      Global Game Jam 2027 Hiroshima (Setouchi Site) | 48-Hour Game-Making Event
    </title>
    <meta
      name="description"
      content="Make a game in 48 hours in Hiroshima—open to international residents, exchange students, beginners, and solo creators. Jan 29–31, 2027 at Hiroshima Institute of Technology. Free admission, ages 15+, with on-site English support."
    />
    <link rel="canonical" href="https://hiro-uni.github.io/ggj/en/" />
    <link
      rel="alternate"
      hreflang="ja"
      href="https://hiro-uni.github.io/ggj/"
    />
    <link
      rel="alternate"
      hreflang="en"
      href="https://hiro-uni.github.io/ggj/en/"
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href="https://hiro-uni.github.io/ggj/"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      property="og:title"
      content="GGJ 2027 Hiroshima (Setouchi Site) | 48 Hours to Make Games Together"
    />
    <meta
      property="og:description"
      content="Join local and international creators in Hiroshima for a 48-hour game jam. Jan 29–31, 2027 at Hiroshima Institute of Technology. Free entry, English support available."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://hiro-uni.github.io/ggj/en/" />
    <meta property="og:site_name" content="Hiroshima Unity Study Group" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="ja_JP" />
    <meta
      property="og:image"
      content={new URL(setouchiLogo.src, "https://hiro-uni.github.io").href}
    />
    <meta property="og:image:alt" content="Global Game Jam Setouchi logo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="GGJ 2027 Hiroshima (Setouchi Site) | 48 Hours to Make Games Together"
    />
    <meta
      name="twitter:description"
      content="Join local and international creators in Hiroshima for a 48-hour game jam. Jan 29–31, 2027 at Hiroshima Institute of Technology. Free entry, English support available."
    />
    <meta
      name="twitter:image"
      content={new URL(setouchiLogo.src, "https://hiro-uni.github.io").href}
    />
    <meta name="twitter:image:alt" content="Global Game Jam Setouchi logo" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
      integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(eventData).replaceAll("<", "\\u003c")}
    />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to main content
    </a>
    <header class="site-header">
      <a
        class="refresh-brand"
        href="#top"
        aria-label="GGJ 2027 Setouchi in Hiroshima top"
      >
        <Image
          src={setouchiLogo}
          alt=""
          width="110"
          height="60"
          loading="eager"
          class="refresh-brand-mark"
        />
        <span>GGJ 2027<small>Setouchi in Hiroshima</small></span>
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-controls="main-nav"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <span></span><span></span><span></span>
      </button>
      <nav id="main-nav" aria-label="Main navigation">
        <a href="#about">About GGJ</a>
        <a href="#schedule">Schedule</a>
        <a href="#faq">FAQ</a>
        <a href="/ggj/" lang="ja" hreflang="ja">日本語</a>
        <a class="nav-entry" href="#entry">Register ↗</a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <div class="landing-grid" id="top">
        <div class="landing-primary">
          <section class="landing-hero" aria-labelledby="hero-title">
            <div class="hero-shapes" aria-hidden="true">
              <span></span><span></span><span></span><span></span><span></span>
            </div>
            <div class="landing-copy">
              <p class="landing-kicker">GLOBAL GAME JAM 2027 · HIROSHIMA</p>
              <h1 id="hero-title">GGJ <em>2027</em></h1>
              <p class="landing-place">Setouchi Site in Hiroshima</p>
              <p class="landing-description">
                One global theme. 48 hours to create a game together in
                Hiroshima.<br />
                International residents, exchange students, beginners, and solo
                participants are all warmly welcome.
              </p>
              <p class="landing-fact">
                <i class="fa-regular fa-calendar" aria-hidden="true"></i> Jan 29
                (Fri) – Jan 31 (Sun), 2027
              </p>
              <p class="landing-fact">
                <i class="fa-solid fa-location-dot" aria-hidden="true"></i>{" "}
                Hiroshima Institute of Technology (Itsukaichi Campus)
              </p>
              <div class="landing-actions">
                <a class="refresh-button" href="#entry">Register Free ↗</a>
                <a class="refresh-button outline" href="#about">
                  What is GGJ? <span aria-hidden="true">ⓘ</span>
                </a>
              </div>
            </div>
            <div class="landing-art">
              <img
                src="/ggj27/assets/jam/hero-hiroshima-1024.webp"
                srcset="/ggj27/assets/jam/hero-hiroshima-640.webp 640w, /ggj27/assets/jam/hero-hiroshima-1024.webp 1024w"
                sizes="(max-width: 760px) calc(100vw - 32px), (max-width: 1050px) 28vw, (max-width: 1440px) 32vw, 440px"
                alt="Participants collaborating on games at a past Hiroshima Global Game Jam"
                width="1024"
                height="768"
                fetchpriority="high"
              />
              <span class="art-badge">
                <i class="fa-solid fa-gamepad" aria-hidden="true"></i> LET’S
                MAKE<br />GAMES!
              </span>
            </div>
          </section>
          <div class="feature-strip" aria-label="Event highlights">
            <div>
              <i class="fa-solid fa-users" aria-hidden="true"></i>
              <strong>Team Up<br />Beginners Welcome</strong>
            </div>
            <div>
              <i class="fa-solid fa-code" aria-hidden="true"></i>
              <strong>48 Hours<br />to Make a Game</strong>
            </div>
            <div>
              <i class="fa-solid fa-globe" aria-hidden="true"></i>
              <strong>One Global<br />Secret Theme</strong>
            </div>
            <div>
              <i class="fa-regular fa-heart" aria-hidden="true"></i>
              <strong>Create &amp; Meet<br />Locals in Hiroshima</strong>
            </div>
          </div>
          <div class="beginner-banner">
            <i class="fa-solid fa-seedling" aria-hidden="true"></i>
            <div>
              <strong>New to game jams or Japan?</strong>
              <p>
                No prior game dev experience, pre-made ideas, or fluent
                Japanese needed. On-site English support is available.
              </p>
            </div>
            <a class="refresh-link" href="#faq">Read the FAQ →</a>
          </div>
        </div>
        <aside class="landing-sidebar" aria-label="Event quick info">
          <section class="quick-card">
            <div class="quick-heading">
              <h2>Schedule</h2>
              <a href="#schedule">Full schedule →</a>
            </div>
            <div class="quick-day">
              <b>Jan 29 (Fri)</b>
              <p>
                16:30 Check-in &amp; Doors Open<br />
                17:00 Rules &amp; Global Keynote<br />
                17:30 Ideathon &amp; Team Formation
              </p>
            </div>
            <div class="quick-day">
              <b>Jan 30 (Sat)</b>
              <p>17:00 Mid-jam Showcase &amp; Alpha Build</p>
            </div>
            <div class="quick-day">
              <b>Jan 31 (Sun)</b>
              <p>
                16:00 Development Ends<br />
                17:00 Final Showcase<br />
                19:00 Venue Closes
              </p>
            </div>
          </section>
          <section class="quick-card">
            <div class="quick-heading">
              <h2>Past Jams</h2>
              <a href="#memories">See photos →</a>
            </div>
            <div class="quick-photos">
              <img
                src="/ggj27/assets/opening.jpg"
                alt="Participants gathering on opening day"
                loading="lazy"
              />
              <img
                src="/ggj27/assets/jam/hero-hiroshima-640.webp"
                alt="Teams building games at the Hiroshima venue"
                loading="lazy"
              />
              <img
                src="/ggj27/assets/jam/about-hiroshima-640.webp"
                alt="Participants presenting their games"
                loading="lazy"
              />
            </div>
          </section>
          <section class="quick-card quick-faq">
            <div class="quick-heading">
              <h2>Quick FAQ</h2>
            </div>
            <a href="#faq-beginner">
              Can I join if I’ve never made a game before? <span>⌄</span>
            </a>
            <a href="#faq-english">
              Can I participate if I don’t speak fluent Japanese?{" "}
              <span>⌄</span>
            </a>
            <a href="#faq-solo">
              Is it okay to come on my own? <span>⌄</span>
            </a>
          </section>
        </aside>
      </div>
      <section
        class="section jam-memories"
        id="memories"
        tabindex="-1"
        aria-labelledby="memories-title"
      >
        <div class="section-heading">
          <h2 id="memories-title">Inside Past Hiroshima Jams</h2>
        </div>
        <div class="jam-photo-grid">
          <figure>
            <img
              src="/ggj27/assets/opening.jpg"
              sizes="(min-width: 800px) 50vw, 100vw"
              alt="Participants gathering around tables at the Hiroshima venue"
              width="1024"
              height="768"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <h3>Ideathon &amp; Team Formation</h3>
              <p>
                Day 1 starts with an ideathon. After watching the global keynote
                and theme reveal, everyone shares ideas and forms teams on the
                spot—coming solo is completely normal!
              </p>
            </figcaption>
          </figure>
          <figure>
            <img
              src="/ggj27/assets/develop-960.webp"
              srcset="/ggj27/assets/develop-480.webp 480w, /ggj27/assets/develop-960.webp 960w"
              sizes="auto, (max-width: 799px) calc(100vw - 40px), (max-width: 1240px) 30vw, 382px"
              alt="Screenshot of a puzzle game created at a past Hiroshima jam"
              width="960"
              height="708"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <h3>Bring Your Own Strengths</h3>
              <p>
                Games need more than code: illustration, 3D modeling, sound,
                writing, level rules, and playtesting all make a project shine.
                Bring the skills you have—or something new you want to try.
              </p>
            </figcaption>
          </figure>
          <figure>
            <img
              src="/ggj27/assets/jam/about-hiroshima-1024.webp"
              srcset="/ggj27/assets/jam/about-hiroshima-640.webp 640w, /ggj27/assets/jam/about-hiroshima-1024.webp 1024w"
              sizes="(min-width: 800px) 50vw, 100vw"
              alt="A team presenting their finished game at the Hiroshima venue"
              width="1024"
              height="768"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <h3>Showcase &amp; Playtest Together</h3>
              <p>
                On Sunday evening, teams present what they built and play each
                other’s games. Share feedback, celebrate bold experiments, and
                leave with new friends in Hiroshima.
              </p>
            </figcaption>
          </figure>
        </div>
        <div class="jam-first-visit">
          <div>
            <h3>Worried about your first game jam?</h3>
            <p>
              <strong>
                Don’t worry—about 60% of our participants every year are
                first-time game makers!
              </strong>
              <br />
              You don’t need a pre-formed team or game pitch ahead of time. Just
              installing and trying out the basics of any tool you’d like to use
              beforehand will help you jump right in.
            </p>
          </div>
        </div>
      </section>
      <section
        class="section jam-works"
        id="games"
        tabindex="-1"
        aria-labelledby="games-title"
      >
        <h2 id="games-title">Games Made in Hiroshima</h2>
        <p class="section-intro">
          The 2026 theme was{" "}
          <strong>
            <a href="https://www.youtube.com/watch?v=tStqPX_LQzg">“Mask”</a>
          </strong>
          .
          <br />
          One prompt, wildly different <strong>experiences</strong>. Here are a
          few games created at the Hiroshima site.
        </p>
        <div class="ggj-card-carousel">
          <div class="jam-game-grid ggj-card-track" id="game-cards" role="group" aria-labelledby="games-title" tabindex="0">
            {
              pastGames.map((game) => (
                <article class="jam-game-card">
                  <div class="jam-game-image">
                    <img
                      src={`/ggj27/assets/${game.image}`}
                      alt={`Screenshot of ${game.title}`}
                      width="800"
                      height="450"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="jam-game-body">
                    <p class="jam-game-genre">{game.genre}</p>
                    <h3>{game.title}</h3>
                    <p>{game.description}</p>
                    <a
                      class="text-link"
                      href={game.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Play &amp; view project <span aria-hidden="true">↗</span>
                      <span class="sr-only">
                        : {game.title} (opens in a new tab)
                      </span>
                    </a>
                  </div>
                </article>
              ))
            }
          </div>
          <GgjCarouselControls trackId="game-cards" count={pastGames.length} en />
        </div>
        <div class="jam-works-footer">
          <a
            class="text-link"
            href="https://globalgamejam.org/group/31042/games"
            target="_blank"
            rel="noopener noreferrer"
          >
            View all 6 games from Hiroshima 2026 ↗
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
        <div class="jam-works-footer">
          <a
            class="text-link"
            href="https://www.youtube.com/live/aVqY0quFrxA?si=b4bdlUl9X17nMRgT&t=397"
            target="_blank"
            rel="noopener noreferrer"
          >
            Watch the GGJ26 Setouchi Final Showcase on YouTube ↗
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
      </section>
      <section
        class="section px-6 py-16 md:py-24 about"
        id="about"
        tabindex="-1"
        aria-labelledby="about-title"
      >
        <div class="split-layout">
          <div>
            <h2 id="about-title">What is Global Game Jam?</h2>
            <p class="lead">
              48 hours of making games worldwide around one shared theme
            </p>
            <p>
              <strong>
                Global Game Jam (GGJ) is the world’s largest game-creation
                event, where creators everywhere build games around the same
                secret theme over one weekend.
              </strong>{" "}
              In January 2026, 39,069 participants across 94 countries created
              9,874 games.
            </p>
            <p>
              Just like a musical jam session, GGJ is about bringing your ideas
              and curiosity together with others—not competing for polish, but
              enjoying the creative spark of brainstorming, building, and
              playing side by side in Hiroshima.
            </p>
          </div>
          <div class="world-card" aria-label="Global Game Jam around the world">
            <h3>
              Around the World: <span>“Let’s Make Games!”</span>
            </h3>
            <div class="world-stage" role="group" aria-label="Languages around the world">
              <button
                type="button"
                class="world-prev"
                aria-label="Previous location"
              >
                ‹
              </button>
              <div class="world-scene">
                <div class="world-canvas" aria-hidden="true"></div>
                <div class="world-pin-label">
                  <p class="world-bubble" lang={worldPlaces[0].lang}>
                    {worldPlaces[0].phrase}
                  </p>
                  <span class="world-location">
                    {worldPlaces[0].locationEn}
                  </span>
                  <span class="world-pin" aria-hidden="true">
                    <i class="fa-solid fa-location-dot"></i>
                  </span>
                </div>
                <i
                  class="fa-solid fa-earth-asia world-globe world-fallback"
                  aria-hidden="true"
                ></i>
              </div>
              <button
                type="button"
                class="world-next"
                aria-label="Next location"
              >
                ›
              </button>
              <p class="world-swipe-hint">
                <i class="fa-solid fa-hand-pointer" aria-hidden="true"></i>
                Swipe left or right
              </p>
            </div>
            <div class="world-stats">
              <div>
                <i class="fa-solid fa-users" aria-hidden="true"></i>
                <div>
                  <span>Countries</span>
                  <strong>94</strong>
                </div>
              </div>
              <div>
                <i class="fa-solid fa-gamepad" aria-hidden="true"></i>
                <div>
                  <span>Games Made</span>
                  <strong>9,874</strong>
                </div>
              </div>
              <div>
                <i class="fa-regular fa-clock" aria-hidden="true"></i>
                <div>
                  <span>Duration</span>
                  <strong>
                    48 <small>hrs</small>
                  </strong>
                </div>
              </div>
            </div>
            <p class="world-stats-note">
              Source: Official 2026 GGJ Global Report
            </p>
          </div>
        </div>
        <GgjPastThemes lang="en" />
      </section>
      <section
        class="section px-6 py-16 md:py-24 welcome"
        aria-labelledby="welcome-title"
      >
        <div class="section-heading">
          <h2 id="welcome-title">Who Should Join?</h2>
        </div>
        <div class="welcome-grid">
          <article>
            <h3>First-Time Game Makers</h3>
            <p>
              Whether you’ve just opened Unity, Unreal Engine, or Godot—or
              haven’t tried any engine yet—get hands-on, experiment, and
              experience the thrill of bringing a playable idea to life.
            </p>
          </article>
          <article>
            <h3>More Than Just Coding</h3>
            <p>
              <strong>Art, music, writing, UI, and playful ideas.</strong>{" "}
              Every game team needs diverse talents. Bring whatever you love
              creating, or team up to try a brand-new role.
            </p>
          </article>
          <article>
            <h3>Meet Locals &amp; Fellow Expats</h3>
            <p>
              <strong>Solo participants are super welcome.</strong> From
              international students and ALTs to engineers and local developers
              in Hiroshima, meet new people by making something together.
            </p>
          </article>
        </div>
        <a class="text-link" href="#faq">
          Check common questions{" "}
          <i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
        </a>
        <figure
          class="character-showcase showcase-right"
          data-engine="unity"
          aria-label="UNITY character"
        >
          <figcaption>
            <b class="character-engine">UNITY</b>
            <span class="character-name">Otori Kohaku / Unity-chan</span>
          </figcaption>
          <Image
            class="showcase-image"
            src={unity}
            alt="Otori Kohaku / Unity-chan"
            width="520"
            height="735"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </section>
      <section
        class="section px-6 py-16 md:py-24 info"
        id="info"
        tabindex="-1"
        aria-labelledby="info-title"
      >
