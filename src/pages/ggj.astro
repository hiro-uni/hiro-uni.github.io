---
import "../styles/ggj27-page.css";
import { Image } from "astro:assets";
import setouchiLogo from "../assets/ggj27/ggj_setouchi_logo.png";
import hiroshimaLogo from "../assets/ggj27/ggj27_logo.png";
import unity from "../assets/ggj27/unity.png";
import gray from "../assets/ggj27/gray.png";
import godot from "../assets/ggj27/godotten.png";
import { worldPlaces } from "../scripts/ggj27-world-places.js";
import GgjPastThemes from "../components/GgjPastThemes.astro";
import GgjCarouselControls from "../components/GgjCarouselControls.astro";
import GgjFaq from "../components/GgjFaq.astro";
import faqEntries from "../data/ggj-faq-ja.js";
import "../styles/ggj27-sections.css";
import "../styles/ggj27-refresh.css";
// Descriptions and destinations: https://globalgamejam.org/group/31042/games
const pastGames = [
  {
    title: "カックンパックン",
    genre: "パズル",
    description:
      "同じ表情の顔をつなげて、最後のひとつに。マスクを使って、ドラッグ＆ドロップで挑む謎解きパズル。",
    image: "kakkun.png",
    url: "https://globalgamejam.org/games/2026/kackun-packskatsukunhatsukun-0",
  },
  {
    title: "なりきり脱出ゲーム",
    genre: "脱出ゲーム",
    description:
      "うさぎやうしの仮面を被って動物の目線になりきり、時計が12時を指す前に迷路の出口へ。",
    image: "narikiri.png",
    url: "https://globalgamejam.org/games/2026/narikirituochukemu-9",
  },
  {
    title: "黴菌魂 (バイキンダマシイ)",
    genre: "アクション",
    description:
      "ちびウイルスたちで自分をマスクして、しぶとく生き残ろう。",
    image: "baikin-damashi.png",
    url: "https://globalgamejam.org/games/2026/peijunhun-4",
  },
];
const eventData = {
  "@context": "https://schema.org",
  "@type": "Event",
  "@id": "https://hiro-uni.github.io/ggj/#event",
  name: "Global Game Jam 2027 瀬戸内会場 in 広島",
  description:
    "ゲーム制作が初めてでも、ひとりでも。仲間と共通のテーマからゲームをつくる48時間のイベント。広島工業大学で開催。参加無料。",
  url: "https://hiro-uni.github.io/ggj/",
  startDate: "2027-01-29T17:00:00+09:00",
  endDate: "2027-01-31T19:00:00+09:00",
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: {
    "@type": "Place",
    name: "広島工業大学 五日市キャンパス 新4号館 4階418号室 (HIT Innovation Lab)",
    address: {
      "@type": "PostalAddress",
      streetAddress: "三宅2丁目1-1 新4号館 4階418号室",
      addressLocality: "広島市佐伯区",
      addressRegion: "広島県",
      postalCode: "731-5143",
      addressCountry: "JP",
    },
  },
  image: [
    "https://hiro-uni.github.io/ggj27/assets/jam/hero-hiroshima-1024.webp",
  ],
  isAccessibleForFree: true,
  performer: {
    "@type": "Person",
    name: "山根信二",
  },
  offers: {
    "@type": "Offer",
    price: 0,
    priceCurrency: "JPY",
    url: "https://hirouni.connpass.com/event/408904/",
    validFrom: "2026-10-30T12:31:00+09:00",
    availability: "https://schema.org/InStock",
  },
  organizer: [
    {
      "@type": "Organization",
      name: "広島工業大学 IoT・AI・データサイエンス教育研究推進センター",
      url: "https://www.it-hiroshima.ac.jp/about/gp/center/iot.html",
    },
    {
      "@type": "Organization",
      name: "広島Unity勉強会",
      url: "https://hiro-uni.github.io/",
    },
  ],
  inLanguage: "ja",
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Global Game Jam 2027 瀬戸内会場 in 広島｜48時間のゲーム制作イベント</title>
    <meta
      name="description"
      content="ゲーム制作が初めてでも、ひとりでも。2027年1月29日〜31日、広島工業大学で仲間とゲームをつくる48時間。参加無料。15歳以上（高校生を含む）、プロ・アマ問わず。Global Game Jam 2027 瀬戸内会場 in 広島の参加案内。"
    />
    <link rel="canonical" href="https://hiro-uni.github.io/ggj/" />
    <link
      rel="alternate"
      hreflang="ja"
      href="https://hiro-uni.github.io/ggj/"
    />
    <link
      rel="alternate"
      hreflang="en"
      href="https://hiro-uni.github.io/ggj/en/"
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href="https://hiro-uni.github.io/ggj/"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      property="og:title"
      content="GGJ 2027 瀬戸内会場 in 広島｜初めてでも、ひとりでも。"
    />
    <meta
      property="og:description"
      content="仲間とゲームをつくる48時間。2027年1月29日〜31日・広島工業大学・参加無料。"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://hiro-uni.github.io/ggj/" />
    <meta property="og:site_name" content="広島Unity勉強会" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta
      property="og:image"
      content={new URL(setouchiLogo.src, "https://hiro-uni.github.io").href}
    />
    <meta property="og:image:alt" content="Global Game Jam Setouchiのロゴ" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="GGJ 2027 瀬戸内会場 in 広島｜初めてでも、ひとりでも。"
    />
    <meta
      name="twitter:description"
      content="仲間とゲームをつくる48時間。2027年1月29日〜31日・広島工業大学・参加無料。"
    />
    <meta
      name="twitter:image"
      content={new URL(setouchiLogo.src, "https://hiro-uni.github.io").href}
    />
    <meta name="twitter:image:alt" content="Global Game Jam Setouchiのロゴ" />

    <link
      rel="preload"
      href="/ggj27/assets/mochiy-pop-one-hero.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
      integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(eventData).replaceAll("<", "\\u003c")}
    />
  </head>
  <body>
    <a class="skip" href="#main">
      本文へスキップ
    </a>
    <header class="site-header">
      <a class="refresh-brand" href="#top" aria-label="GGJ 2027 瀬戸内 トップ">
        <Image src={hiroshimaLogo} alt="Global Game Jam 2027 瀬戸内会場 in 広島" width="240" height="74" loading="eager" />
      </a>
      <button class="menu-toggle" type="button" aria-controls="main-nav" aria-expanded="false" aria-label="メニューを開く"><span></span><span></span><span></span></button>
      <nav id="main-nav" aria-label="メインナビゲーション">
        <a href="#about">GGJとは</a><a href="#schedule">スケジュール</a><a href="#faq">FAQ</a><a href="/ggj/en/" lang="en" hreflang="en">English</a>
        <a class="nav-entry" href="#entry">参加登録する ↗</a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <div class="landing-grid" id="top">
        <div class="landing-primary">
          <section class="landing-hero" aria-labelledby="hero-title">
            <div class="hero-shapes" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
            <div class="landing-copy">
              <h1 id="hero-title" class="landing-logo"><Image src={hiroshimaLogo} alt="Global Game Jam 2027 瀬戸内会場 in 広島" width="667" height="207" loading="eager" /></h1>
              <p class="landing-description">初日に出会った仲間と48時間でゲームをつくる。だれもが参加できる世界最大級のゲームジャム。</p>
              <p class="landing-fact"><i class="fa-regular fa-calendar" aria-hidden="true"></i> 2027.1.29 (Fri) – 1.31 (Sun)</p>
              <p class="landing-fact"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> 広島工業大学 五日市キャンパス</p>
              <div class="landing-actions">
                <a class="refresh-button" href="#entry">参加登録する（無料） ↗</a>
                <a class="refresh-button outline" href="#about">GGJとは？ <span aria-hidden="true">ⓘ</span></a>
              </div>
            </div>
            <div class="landing-art">
              <img
                src="/ggj27/assets/jam/hero-hiroshima-1024.webp"
                srcset="/ggj27/assets/jam/hero-hiroshima-640.webp 640w, /ggj27/assets/jam/hero-hiroshima-1024.webp 1024w"
                sizes="(max-width: 760px) calc(100vw - 32px), (max-width: 1050px) 28vw, (max-width: 1440px) 32vw, 440px"
                alt="過去の広島会場でゲームを制作する参加者"
                width="1024"
                height="768"
                fetchpriority="high"
              />
              <span class="art-badge"><i class="fa-solid fa-gamepad" aria-hidden="true"></i> LET’S MAKE<br />GAMES!</span>
            </div>
          </section>
          <div class="feature-strip" aria-label="イベントの特徴">
            <div><i class="fa-solid fa-users" aria-hidden="true"></i><strong>チームでつくる<br />初参加も歓迎</strong></div><div><i class="fa-solid fa-code" aria-hidden="true"></i><strong>48時間で<br />ゲームを開発</strong></div><div><i class="fa-solid fa-globe" aria-hidden="true"></i><strong>世界共通の<br />テーマに挑戦</strong></div><div><i class="fa-regular fa-heart" aria-hidden="true"></i><strong>つくることを<br />楽しむイベント</strong></div>
          </div>
          <div class="beginner-banner"><i class="fa-solid fa-seedling" aria-hidden="true"></i><div><strong>初めての方へ</strong><p>開発経験やアイデアは不要です。ゲーム制作未経験の方も参加できます。</p></div><a class="refresh-link" href="#faq">よくある質問 →</a></div>
        </div>
        <aside class="landing-sidebar" aria-label="イベント情報">
          <section class="quick-card"><div class="quick-heading"><h2>スケジュール</h2><a href="#schedule">詳細を見る →</a></div><div class="quick-day"><b>1.29 (Fri)</b><p>16:30　受付・入場開始<br />17:00　ルール説明・基調講演<br />17:30　アイデアソン・チーム編成</p></div><div class="quick-day"><b>1.30 (Sat)</b><p>17:00　中間発表・アルファ版完成</p></div><div class="quick-day"><b>1.31 (Sun)</b><p>16:00　開発終了<br />17:00　最終発表会<br />19:00　完全撤収</p></div></section>
          <section class="quick-card"><div class="quick-heading"><h2>過去の様子</h2><a href="#memories">詳しく見る →</a></div><div class="quick-photos"><img src="/ggj27/assets/opening.jpg" alt="参加者が集まる様子" loading="lazy" /><img src="/ggj27/assets/jam/hero-hiroshima-640.webp" alt="会場で制作する様子" loading="lazy" /><img src="/ggj27/assets/jam/about-hiroshima-640.webp" alt="作品を発表する様子" loading="lazy" /></div></section>
          <section class="quick-card quick-faq"><div class="quick-heading"><h2>よくある質問</h2></div><a href="#faq-beginner">ゲーム制作が初めてでも参加できますか？ <span>⌄</span></a><a href="#faq-solo">ひとりでの参加はできますか？ <span>⌄</span></a><a href="#faq-second-day">2日目から参加できますか？ <span>⌄</span></a></section>
        </aside>
      </div>
      <section
        class="section jam-memories"
        id="memories"
        tabindex="-1"
        aria-labelledby="memories-title"
      >
        <div class="section-heading">
          <h2 id="memories-title">過去の広島会場の様子
          </h2>
        </div>
        <div class="jam-photo-grid">
          <figure>
            <img
              src="/ggj27/assets/opening.jpg"
              sizes="(min-width: 800px) 50vw, 100vw"
              alt="広島会場で参加者がテーブルを囲んで集まる様子"
              width="1024"
              height="768"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <h3>アイデア出しとチーム編成</h3>
              <p>
                初日はアイデアソンからスタート。基調講演を見て、つくってみたいことを話し合い、その場でチームを組みます。ひとりでの参加も歓迎です。
              </p>
            </figcaption>
          </figure>
          <figure>
            <img
              src="/ggj27/assets/develop-960.webp"
              srcset="/ggj27/assets/develop-480.webp 480w, /ggj27/assets/develop-960.webp 960w"
              sizes="auto, (max-width: 799px) calc(100vw - 40px), (max-width: 1240px) 30vw, 382px"
              alt="過去の広島会場で制作されたパズルゲームの画面"
              width="960"
              height="708"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <h3>それぞれの得意分野で制作</h3>
              <p>
                プログラムだけでなく、絵を描く、音をつくる、ルールを考える、遊んで感想を伝えることもゲームづくりの一部。できることや挑戦したいことを持ち寄ろう。
              </p>
            </figcaption>
          </figure>
          <figure>
            <img
              src="/ggj27/assets/jam/about-hiroshima-1024.webp"
              srcset="/ggj27/assets/jam/about-hiroshima-640.webp 640w, /ggj27/assets/jam/about-hiroshima-1024.webp 1024w"
              sizes="(min-width: 800px) 50vw, 100vw"
              alt="広島会場でチームが制作したゲームを紹介する様子"
              width="1024"
              height="768"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <h3>完成したゲームを発表・試遊</h3>
              <p>
                最後はつくったゲームを発表し、みんなで試遊。思いつきから生まれた作品を見せ合い、感想や新しい発見を持ち帰ろう。
              </p>
            </figcaption>
          </figure>
        </div>
        <div class="jam-first-visit">
          <div>
            <h3>初めてのゲームジャムでも、大丈夫？</h3>
            <p><strong>大丈夫です！毎年参加者の6割が ゲーム開発未経験 の人です。</strong><br>事前にチームやゲームの企画を用意する必要はありません。参加前に使いたいツールの基本操作を学んでおくと安心です。</p>
          </div>
        </div>
      </section>
      <section
        class="section jam-works"
        id="games"
        tabindex="-1"
        aria-labelledby="games-title"
      >
        <h2 id="games-title">過去の参加作品
        </h2>
        <p class="section-intro">
          2026年のテーマは <strong><a href="https://www.youtube.com/watch?v=tStqPX_LQzg">『Mask(マスク/仮面)』</a></strong>
          <br>
          同じテーマから違う <strong>体験</strong> へ。広島会場で制作された作品をご紹介します。
        </p>
        <div class="ggj-card-carousel">
          <div class="jam-game-grid ggj-card-track" id="game-cards" role="group" aria-labelledby="games-title" tabindex="0">
            {pastGames.map((game) => (
              <article class="jam-game-card">
                <div class="jam-game-image">
                  <img
                    src={`/ggj27/assets/${game.image}`}
                    alt={`${game.title}のゲーム画面`}
                    width="800"
                    height="450"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="jam-game-body">
                  <p class="jam-game-genre">{game.genre}</p>
                  <h3>{game.title}</h3>
                  <p>{game.description}</p>
                  <a
                    class="text-link"
                    href={game.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    遊んでみる <span aria-hidden="true">↗</span>
                    <span class="sr-only">
                      ：{game.title}（新しいタブで開きます）
                    </span>
                  </a>
                </div>
              </article>
            ))}
          </div>
          <GgjCarouselControls trackId="game-cards" count={pastGames.length} />
        </div>
        <div class="jam-works-footer">
          <a
            class="text-link"
            href="https://globalgamejam.org/group/31042/games"
            target="_blank"
            rel="noopener noreferrer"
          >
            2026年広島会場の全6作品を見る ↗
            <span class="sr-only">（新しいタブで開きます）</span>
          </a>
        </div>
        <div class="jam-works-footer">
          <a
            class="text-link"
            href="https://www.youtube.com/live/aVqY0quFrxA?si=b4bdlUl9X17nMRgT&t=397"
            target="_blank"
            rel="noopener noreferrer"
          >
            YouTube で GGJ26瀬戸内 最終発表会を見る ↗
            <span class="sr-only">（新しいタブで開きます）</span>
          </a>
        </div>
      </section>
      <section
        class="section px-6 py-16 md:py-24 about"
        id="about"
        tabindex="-1"
        aria-labelledby="about-title"
      >
        <div class="split-layout">
          <div>
            <h2 id="about-title">Global Game Jamとは？
            </h2>
            <p class="lead">
              世界共通のテーマでゲームを制作する48時間
            </p>
            <p>
              <strong>
                Global Game Jam（GGJ）は、世界各地の参加者が共通のテーマからゲームをつくるイベント。
              </strong>
                2026年1月には、94か国の3.9万人が参加。9874個のゲームがリリースされました。
            </p>
            <p>
              「ジャム」は、音楽のジャムセッションみたいに、アイデアや得意なことを持ち寄ること。完成度を競うより、一緒に考えて、つくって、遊ぶ時間を楽しもう。
            </p>
          </div>
          <div class="world-card" aria-label="世界のゲームジャム">
            <h3>世界中で <span>「ゲームを作ろう！」</span></h3>
            <div class="world-stage" role="group" aria-label="世界の言葉の地球儀">
              <button type="button" class="world-prev" aria-label="前の場所">‹</button>
              <div class="world-scene"><div class="world-canvas" aria-hidden="true"></div><div class="world-pin-label"><p class="world-bubble" lang={worldPlaces[0].lang}>{worldPlaces[0].phrase}</p><span class="world-location">{worldPlaces[0].location}</span><span class="world-pin" aria-hidden="true"><i class="fa-solid fa-location-dot"></i></span></div><i class="fa-solid fa-earth-asia world-globe world-fallback" aria-hidden="true"></i></div>
              <button type="button" class="world-next" aria-label="次の場所">›</button>
              <p class="world-swipe-hint">
                <i class="fa-solid fa-hand-pointer" aria-hidden="true"></i>
                左右にスワイプ
              </p>
            </div>
            <div class="world-stats"><div><i class="fa-solid fa-users" aria-hidden="true"></i><div><span>参加国</span><strong>94 <small>か国</small></strong></div></div><div><i class="fa-solid fa-gamepad" aria-hidden="true"></i><div><span>制作されたゲーム</span><strong>9874 <small>個</small></strong></div></div><div><i class="fa-regular fa-clock" aria-hidden="true"></i><div><span>開発時間</span><strong>48 <small>時間</small></strong></div></div></div>
            <p class="world-stats-note">引用 : 2026年 GGJ公式レポート より</p>
          </div>
        </div>
        <GgjPastThemes />
      </section>
      <section
        class="section px-6 py-16 md:py-24 welcome"
        aria-labelledby="welcome-title"
      >
        <div class="section-heading">
          <h2 id="welcome-title">こんな方におすすめ
          </h2>
        </div>
        <div class="welcome-grid">
          <article>
            <h3>初めてのゲームづくりに。</h3>
            <p>
              Unreal Engine や Unity を学び始めた人も、これから触ってみたい人も。手を動かして、試して、ゲームができていく面白さを味わってみよう。
            </p>
          </article>
          <article>
            <h3>プログラム以外の「好き」も。</h3>
            <p>
              <strong>絵、音楽、物語、遊びのアイデア。</strong>
              ゲームづくりには、いろんな出番があります。好きなことや得意なことを、気軽に持ち寄ってみてください。
            </p>
          </article>
          <article>
            <h3>ひとりで来て、仲間に出会う。</h3>
            <p>
              <strong>ひとりでの参加も大歓迎。</strong>
              学生も、現役の開発者も、まずはアイデアを話すところから。チームを組んでゲームを作ろう。
            </p>
          </article>
        </div>
        <a class="text-link" href="#faq">
          初めての「気になる」をチェック{" "}
          <i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
        </a>
