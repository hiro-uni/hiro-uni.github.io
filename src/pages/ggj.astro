    <script>
      const countdown = document.querySelector("#hero-countdown");
      const start = Date.parse("2027-01-29T17:00:00+09:00");
      if (countdown) {
        const updateCountdown = () => {
          const remaining = Math.max(0, Math.ceil((start - Date.now()) / 1000));
          if (remaining === 0) {
            countdown.textContent = "開催日時を迎えました！";
            return;
          }
          const days = Math.floor(remaining / 86400);
          const hours = Math.floor((remaining % 86400) / 3600);
          const minutes = Math.floor((remaining % 3600) / 60);
          const seconds = remaining % 60;
          countdown.textContent = `Start In ${days}Days ${hours}:${minutes}:${seconds}`;
        };
        updateCountdown();
        countdown.hidden = false;
        setInterval(updateCountdown, 1000);
      }
    </script>
