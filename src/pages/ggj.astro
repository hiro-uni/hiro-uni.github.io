---
import "../styles/ggj27-page.css";
import { Image } from "astro:assets";
import logo from "../assets/ggj27/ggj27_logo.png";
import setouchiLogo from "../assets/ggj27/ggj_setouchi_logo.png";
import unity from "../assets/ggj27/unity.png";
import gray from "../assets/ggj27/gray.png";
import "../styles/ggj27-sections.css";
import godot from "../assets/ggj27/godotten.png";
// Descriptions and destinations: https://globalgamejam.org/group/31042/games
const pastGames = [
  {
    title: "Kackun Packs（カックンパックン）",
    genre: "パズル",
    description:
      "同じ表情の顔をつなげて、最後のひとつに。ドラッグ＆ドロップで挑む謎解きパズル。",
    image: "kakkun.png",
    url: "https://globalgamejam.org/games/2026/kackun-packskatsukunhatsukun-0",
  },
  {
    title: "なりきり脱出ゲーム",
    genre: "脱出ゲーム",
    description:
      "うさぎやうしの仮面を被って動物になりきり、時計が12時を指す前に迷路の出口へ。",
    image: "narikiri.png",
    url: "https://globalgamejam.org/games/2026/narikirituochukemu-9",
  },
  {
    title: "黴菌魂 (バイキンダマシイ)",
    genre: "アクション",
    description:
      "ちびウイルスたちで自分をマスクして、しぶとく生き残ろう。",
    image: "baikin-damashi.png",
    url: "https://globalgamejam.org/games/2026/peijunhun-4",
  },
];
const eventData = {
  "@context": "https://schema.org",
  "@type": "Event",
  "@id": "https://hiro-uni.github.io/ggj/#event",
  name: "Global Game Jam 2027 瀬戸内会場 in 広島",
  description:
    "ゲーム制作が初めてでも、ひとりでも。仲間と共通のテーマからゲームをつくる48時間のイベント。広島工業大学で開催。参加無料。",
  url: "https://hiro-uni.github.io/ggj/",
  startDate: "2027-01-29T17:00:00+09:00",
  endDate: "2027-01-31T19:00:00+09:00",
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: {
    "@type": "Place",
    name: "広島工業大学 五日市キャンパス 新4号館 4階418号室 (HIT Innovation Lab)",
    address: {
      "@type": "PostalAddress",
      streetAddress: "三宅2丁目1-1 新4号館 4階418号室",
      addressLocality: "広島市佐伯区",
      addressRegion: "広島県",
      postalCode: "731-5143",
      addressCountry: "JP",
    },
  },
  image: [
    "https://hiro-uni.github.io/ggj27/assets/jam/hero-hiroshima-1024.webp",
  ],
  isAccessibleForFree: true,
  performer: {
    "@type": "Person",
    name: "山根信二",
  },
  offers: {
    "@type": "Offer",
    price: 0,
    priceCurrency: "JPY",
    url: "https://hirouni.connpass.com/event/408904/",
    validFrom: "2026-10-30T12:31:00+09:00",
    availability: "https://schema.org/InStock",
  },
  organizer: [
    {
      "@type": "Organization",
      name: "広島工業大学 IoT・AI・データサイエンス教育研究推進センター",
      url: "https://www.it-hiroshima.ac.jp/about/gp/center/iot.html",
    },
    {
      "@type": "Organization",
      name: "広島Unity勉強会",
      url: "https://hiro-uni.github.io/",
    },
  ],
  inLanguage: "ja",
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Global Game Jam 2027 瀬戸内会場 in 広島｜48時間のゲーム制作イベント</title>
    <meta
      name="description"
      content="ゲーム制作が初めてでも、ひとりでも。2027年1月29日〜31日、広島工業大学で仲間とゲームをつくる48時間。参加無料。15歳以上（高校生を含む）、プロ・アマ問わず。Global Game Jam 2027 瀬戸内会場 in 広島の参加案内。"
    />
    <link rel="canonical" href="https://hiro-uni.github.io/ggj/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      property="og:title"
      content="GGJ 2027 瀬戸内会場 in 広島｜初めてでも、ひとりでも。"
    />
    <meta
      property="og:description"
      content="仲間とゲームをつくる48時間。2027年1月29日〜31日・広島工業大学・参加無料。"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://hiro-uni.github.io/ggj/" />
    <meta property="og:site_name" content="広島Unity勉強会" />
    <meta property="og:locale" content="ja_JP" />
    <meta
      property="og:image"
      content={new URL(setouchiLogo.src, "https://hiro-uni.github.io").href}
    />
    <meta property="og:image:alt" content="Global Game Jam Setouchiのロゴ" />
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="preload"
      href="/ggj27/assets/mochiy-pop-one-hero.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
      integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <script type="application/ld+json" set:html={JSON.stringify(eventData)} />
  </head>
  <body>
    <a class="skip" href="#main">
      本文へスキップ
    </a>
    <header class="site-header" inert aria-hidden="true">
      <a class="wordmark" href="#top" aria-label="GGJ 2027 瀬戸内 トップ">
        <Image
          class="wordmark-logo"
          src={setouchiLogo}
          alt="GGJ Setouchi"
          width="160"
          height="88"
          loading="eager"
          decoding="async"
        />
      </a>
      <nav aria-label="メインナビゲーション">
        <a href="#about">GGJとは</a>
        <a href="#info">開催概要</a>
        <a href="#faq">FAQ</a>
        <a href="#english" lang="en">
          English
        </a>
        <a class="nav-entry" href="#entry">
          <i class="fa-solid fa-gamepad" aria-hidden="true"></i>
          <span>参加する！</span>
        </a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <section class="hero" id="top" tabindex="-1" aria-labelledby="hero-title">
        <div class="hero-visual">
          <img
            class="hero-photo"
            src="/ggj27/assets/jam/hero-hiroshima-1024.webp"
            srcset="/ggj27/assets/jam/hero-hiroshima-640.webp 640w, /ggj27/assets/jam/hero-hiroshima-1024.webp 1024w"
            sizes="100vw"
            alt="過去のGlobal Game Jam 広島会場（広島工業大学）の様子"
            width="1024"
            height="768"
            fetchpriority="high"
            decoding="async"
          />
          <div class="hero-shade" aria-hidden="true"></div>
          <div class="hero-content">
            <a
              class="hero-brand"
              href="#top"
              aria-label="Global Game Jam 2027 瀬戸内会場 in 広島"
            >
              <Image
                src={logo}
                alt="グローバルゲームジャム2027 瀬戸内会場 in 広島"
                width="800"
                height="248"
                loading="eager"
                decoding="async"
              />
            </a>
            <a class="hero-language" href="#english" lang="en">
              <i class="fa-solid fa-globe" aria-hidden="true"></i> English guide{" "}
              <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </a>
            <h1 class="hero-title" id="hero-title">
              <span class="sr-only">
                Global Game Jam 2027 瀬戸内会場 in 広島。{" "}
              </span>
              <span>はじまるよ！！</span>
              <span>
                <b class="hero-digits">48</b>時間！！
              </span>
            </h1>
            <div class="hero-message-group">
              <p class="hero-message">
                <strong>初めてでも、ひとりでも。</strong>
                <br />
                仲間とゲームをつくる週末へ。
              </p>
              <p class="hero-countdown" id="hero-countdown" hidden></p>
            </div>
          </div>
        </div>
        <div class="hero-details">
          <div>
            <p class="hero-date">
              <time datetime="2027-01-29">2027.1.29</time>
              <span>—</span>
              <time datetime="2027-01-31">1.31</time>
            </p>
            <p class="hero-venue">広島工業大学 五日市キャンパス</p>
          </div>
          <div class="hero-action">
            <a class="button button-primary" href="#entry">
              <span class="button-label">
                <i class="fa-solid fa-clipboard-check" aria-hidden="true"></i>
                今すぐ参加申し込み！
              </span>
              <span class="button-arrow" aria-hidden="true">
                <i class="fa-solid fa-arrow-down"></i>
              </span>
            </a>
          </div>
        </div>
        <div class="hero-band">
          <strong>参加無料</strong>
          <strong>ゲーム制作の48時間</strong>
          <span>ゲーム制作未経験・ひとり参加歓迎</span>
        </div>
      </section>
      <section
        class="section jam-memories"
        id="memories"
        tabindex="-1"
        aria-labelledby="memories-title"
      >
        <div class="section-heading">
          <h2 id="memories-title">
            ひとりの「やってみたい」が、
            <br />
            みんなのゲームになる。
          </h2>
          <p>
            話して、手を動かして、笑い合う。
            <br />
            ゲームをつくる週末を、ここ広島で。
          </p>
        </div>
        <div class="jam-photo-grid">
          <figure>
            <img
              src="/ggj27/assets/jam/hero-hiroshima-1024.webp"
              srcset="/ggj27/assets/jam/hero-hiroshima-640.webp 640w, /ggj27/assets/jam/hero-hiroshima-1024.webp 1024w"
              sizes="(min-width: 800px) 50vw, 100vw"
              alt="広島会場で参加者がテーブルを囲んで集まる様子"
              width="1024"
              height="768"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <span>01 / 出会う</span>
              <h3>はじめまして、から始めよう。</h3>
              <p>
                好きなゲームや、つくってみたいアイデア。話すことから、チームの時間が動き出す。
              </p>
            </figcaption>
          </figure>
          <figure>
            <img
              src="/ggj27/assets/jam/about-hiroshima-1024.webp"
              srcset="/ggj27/assets/jam/about-hiroshima-640.webp 640w, /ggj27/assets/jam/about-hiroshima-1024.webp 1024w"
              sizes="(min-width: 800px) 50vw, 100vw"
              alt="広島会場でチームが制作したゲームを紹介する様子"
              width="1024"
              height="768"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <span>02 / 分かち合う</span>
              <h3>つくった時間も、作品になる。</h3>
              <p>
                試して、悩んで、できたことを見せ合って。自分たちの挑戦を、みんなで楽しもう。
              </p>
            </figcaption>
          </figure>
        </div>
        <a class="text-link" href="/news/2026-02-02-ggj-report/">
          2026年の開催レポートを見る <span aria-hidden="true">→</span>
        </a>
      </section>
      <section
        class="section jam-works"
        id="games"
        tabindex="-1"
        aria-labelledby="games-title"
      >
        <h2 id="games-title">
          48時間で、
          <br class="mobile-only" />
          こんなゲームが生まれました。
        </h2>
        <p class="section-intro">
          2026年のテーマは<strong>「Mask(マスク/仮面)」</strong>。
          <br>
          同じテーマから、まったく違う「アイデア」から「体験」へ。前回の <strong>体験</strong> を見てみよう。
        </p>
        <div class="jam-game-grid">
          {pastGames.map((game) => (
            <article class="jam-game-card">
              <div class="jam-game-image">
                <img
                  src={`/ggj27/assets/${game.image}`}
                  alt={`${game.title}のゲーム画面`}
                  width="800"
                  height="450"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="jam-game-body">
                <p class="jam-game-genre">{game.genre}</p>
                <h3>{game.title}</h3>
                <p>{game.description}</p>
                <a
                  class="text-link"
                  href={game.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  遊んでみる <span aria-hidden="true">↗</span>
                  <span class="sr-only">
                    ：{game.title}（新しいタブで開きます）
                  </span>
                </a>
              </div>
            </article>
          ))}
        </div>
        <div class="jam-works-footer">
          <a
            class="text-link"
            href="https://globalgamejam.org/group/31042/games"
            target="_blank"
            rel="noopener noreferrer"
          >
            2026年広島会場の全6作品を見る ↗
            <span class="sr-only">（新しいタブで開きます）</span>
          </a>
        </div>
        <div class="jam-works-footer">
          <a
            class="text-link"
            href="https://www.youtube.com/live/aVqY0quFrxA?si=b4bdlUl9X17nMRgT&t=397"
            target="_blank"
            rel="noopener noreferrer"
          >
            YouTube で GGJ27瀬戸内 最終発表会を見る ↗
            <span class="sr-only">（新しいタブで開きます）</span>
          </a>
        </div>
      </section>
      <section
        class="section px-6 py-16 md:py-24 welcome"
        aria-labelledby="welcome-title"
      >
        <div class="section-heading">
          <h2 id="welcome-title">
            「やってみたい」が、
            <br />
            参加する理由になる。
          </h2>
        </div>
        <div class="welcome-grid">
          <article>
            <h3>初めてのゲームづくりに。</h3>
            <p>
              UnityやUnreal
              Engineを学び始めた人も、これから触ってみたい人も。手を動かして、試して、ゲームができていく面白さを味わってみよう。
            </p>
          </article>
          <article>
            <h3>プログラム以外の「好き」も。</h3>
            <p>
              <strong>絵、音楽、物語、遊びのアイデア。</strong>
              ゲームづくりには、いろんな出番があります。好きなことや得意なことを、気軽に持ち寄ってみてください。
            </p>
          </article>
          <article>
            <h3>ひとりで来て、仲間に出会う。</h3>
            <p>
              <strong>ひとりでの参加も大歓迎。</strong>
              学生も、現役の開発者も、まずはアイデアを話すところから。チームを組んでゲームを作ろう。
            </p>
          </article>
        </div>
        <a class="text-link" href="#faq">
          初めての「気になる」をチェック{" "}
          <i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
        </a>
        <figure
          class="character-showcase showcase-right"
          data-engine="unity"
          aria-label="UNITY キャラクター"
        >
          <figcaption>
            <b class="character-engine">UNITY</b>
            <span class="character-name">Otori Kohaku / Unity-chan</span>
          </figcaption>
          <Image
            class="showcase-image"
            src={unity}
            alt="Otori Kohaku / Unity-chan"
            width="520"
            height="735"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </section>
      <section
        class="section px-6 py-16 md:py-24 about"
        id="about"
        tabindex="-1"
        aria-labelledby="about-title"
      >
        <div class="split-layout">
          <div>
            <h2 id="about-title">
              ゲームジャムは、
              <br />
              一緒につくる48時間。
            </h2>
            <p class="lead">
              同じテーマから、
              <br />
              まだない「あそび」を生み出そう。
            </p>
            <p>
              <strong>
                Global Game
                Jam（GGJ）は、世界各地の参加者が共通のテーマからゲームをつくるイベント。
              </strong>
              広島でも、その場で出会った仲間と一緒にゲームをつくります。
            </p>
            <p>
              「ジャム」は、音楽のジャムセッションみたいに、アイデアや得意なことを持ち寄ること。完成度を競うより、一緒に考えて、つくって、遊ぶ時間を楽しもう。
            </p>
          </div>
          <figure class="editorial-photo">
            <img
              src="/ggj27/assets/jam/about-hiroshima-1024.webp"
              srcset="/ggj27/assets/jam/about-hiroshima-640.webp 640w, /ggj27/assets/jam/about-hiroshima-1024.webp 1024w"
              sizes="(min-width: 800px) 45vw, 100vw"
              alt="過去のGlobal Game Jam 広島会場での作品発表の様子"
              width="1024"
              height="768"
              loading="lazy"
              decoding="async"
            />
            <figcaption>過去の広島会場での発表の様子</figcaption>
          </figure>
        </div>
      </section>
      <section
        class="section px-6 py-16 md:py-24 process"
        id="experience"
        tabindex="-1"
        aria-labelledby="process-title"
      >
        <h2 id="process-title">
          出会って、つくって、
          <br class="mobile-only" />
          遊んでみる。
        </h2>
        <p class="section-intro">
          <strong>48時間で体験する、ゲームづくりの流れ。</strong>
        </p>
        <ol role="list" class="process-list">
          <li>
            <span class="step-number" aria-hidden="true">
              01
            </span>
            <h3>出会う・考える</h3>
            <p>
              テーマを聞いたら、自己紹介とアイデア交換。得意なことも、やってみたいことも、まずは話してみよう。
            </p>
          </li>
          <li>
            <span class="step-number" aria-hidden="true">
              02
            </span>
            <h3>つくる・試す</h3>
            <p>
              描く、組む、鳴らす。役割を分けて、さっそく手を動かそう。小さくても、遊べるゲームを目指してみよう。
            </p>
          </li>
          <li>
            <span class="step-number" aria-hidden="true">
              03
            </span>
            <h3>遊ぶ・共有する</h3>
            <p>
              できたゲームを見せ合って、遊んで、感想を交換。「次はこんなのをつくりたい！」が見つかるかも。
            </p>
          </li>
        </ol>
        <a class="button button-outline" href="#entry">
          <span class="button-label">
            <i class="fa-solid fa-shoe-prints" aria-hidden="true"></i>
            参加までの流れを見る
          </span>
          <span class="button-arrow" aria-hidden="true">
            <i class="fa-solid fa-arrow-down"></i>
          </span>
        </a>
        <figure
          class="character-showcase showcase-right"
          data-engine="unreal"
          aria-label="UNREAL ENGINE キャラクター"
        >
          <figcaption>
            <b class="character-engine">
              UNREAL<span>ENGINE</span>
            </b>
            <span class="character-name">Nina Kuratsuki / Gray-chan</span>
          </figcaption>
          <Image
            class="showcase-image"
            src={gray}
            alt="Gray-chan"
            width="520"
            height="735"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </section>
      <section
        class="section px-6 py-16 md:py-24 info"
        id="info"
        tabindex="-1"
        aria-labelledby="info-title"
      >
        <div class="split-layout">
          <div>
            <h2 id="info-title">
              週末の予定に、
              <br />
              ゲームづくりを。
            </h2>
            <p class="section-intro">
              広島で会って、一緒につくる。
              <br />
              <strong>高校生・大学生から社会人まで、</strong>
              <br />
              ゲームづくりに興味のある人へ。
            </p>
          </div>
          <dl class="info-table">
            <div>
              <dt>イベント</dt>
              <dd>
                Global Game Jam 2027
                <br />
                瀬戸内会場 in 広島
              </dd>
            </div>
            <div>
              <dt>開催日</dt>
              <dd>
                <strong>2027年1月29日（金）17:00 〜31日（日）19:00 </strong>
                <span>開発時間は48時間。</span>
              </dd>
            </div>
            <div>
              <dt>会場</dt>
              <dd>
                <strong>
                  広島工業大学 五日市キャンパス 新4号館 4階418号室 (HIT
                  Innovation Lab)
                </strong>
                <span>広島県広島市佐伯区三宅２丁目１</span>
                <a
                  class="text-link"
                  href="https://maps.app.goo.gl/nL7KeJcypyKS8SRK9"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Google Mapで確認 ↗
                  <span class="sr-only">（新しいタブで開きます）</span>
                </a>
              </dd>
            </div>
            <div>
              <dt>参加費</dt>
              <dd>
                <strong>無料</strong>
