                  stroke-width="6"
                  stroke-linecap="round"
                />
                <circle
                  cx="35"
                  cy="21"
                  r="6.5"
                  fill="#FF8F85"
                  stroke="#10265B"
                  stroke-width="2.6"
                />
                <circle cx="34" cy="19.5" r="1.5" fill="#10265B" />
                <path
                  d="M23 30 L19 24 L27 25"
                  fill="#FFD447"
                  stroke="#10265B"
                  stroke-width="2.2"
                  stroke-linejoin="round"
                />
              </svg>
            )}
            {theme.icon === "extinction" && (
              <svg viewBox="0 0 80 80" width="80" height="80" fill="none">
                <path
                  d="M52 17 L64 24"
                  stroke="#FFD447"
                  stroke-width="3"
                  stroke-linecap="round"
                />
                <circle cx="51" cy="16" r="3.5" fill="#FF8F85" stroke="#10265B" stroke-width="2" />
                <path
                  d="M20 57 C20 50 25 46 31 46 H41 V30 C41 25 45 22 50 22 H55 C57 22 58 24 58 26 C58 29 55 31 52 31 H48 V48 C48 53 45 57 40 57 V63 H35 V57 H29 V63 H24 V57 Z"
                  fill="#7FDCC3"
                  stroke="#10265B"
                  stroke-width="2.6"
                  stroke-linejoin="round"
                />
                <circle cx="52" cy="26" r="1.4" fill="#10265B" />
              </svg>
            )}
            {theme.icon === "deception" && (
              <svg viewBox="0 0 80 80" width="80" height="80" fill="none">
                <rect
                  x="19"
                  y="22"
                  width="26"
                  height="36"
                  rx="4"
                  transform="rotate(-12 32 40)"
                  fill="#8ECBFF"
                  stroke="#10265B"
                  stroke-width="2.75"
                />
                <rect
                  x="33"
                  y="21"
                  width="26"
                  height="36"
                  rx="4"
                  transform="rotate(8 46 39)"
                  fill="#FFFFFF"
                  stroke="#10265B"
                  stroke-width="2.75"
                />
                <path
                  d="M46 32 L51 39 L46 46 L41 39 Z"
                  fill="#FF8F85"
                  stroke="#10265B"
                  stroke-width="2.2"
                  stroke-linejoin="round"
                />
                <path
                  d="M22 18 L23.5 20.5 L26 22 L23.5 23.5 L22 26 L20.5 23.5 L18 22 L20.5 20.5 Z"
                  fill="#FFD447"
                />
              </svg>
            )}
            {theme.icon === "problems" && (
              <svg viewBox="0 0 80 80" width="80" height="80" fill="none">
                <path
                  d="M17 31 H34 C34 27 39 27 39 31 V40 C43 40 43 46 39 46 V57 H17 Z"
                  fill="#FFD447"
                  stroke="#10265B"
                  stroke-width="2.6"
                  stroke-linejoin="round"
