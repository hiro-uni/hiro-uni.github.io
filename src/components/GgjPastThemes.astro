                  stroke-linecap="round"
                />
              </svg>
            )}
          </div>
          <div class="theme-card-caption">
            <p class="theme-card-ja">{theme.ja}</p>
            <h4
              class={`theme-card-title${theme.isLong ? " is-long" : ""}`}
              lang="en"
            >
              {theme.title}
            </h4>
          </div>
        </li>
      ))}
    </ol>
  </div>

  <div class="past-themes-footer">
    <div class="past-themes-dots" role="group" aria-label="過去のテーマの表示位置">
      {Array.from({ length: totalDots }, (_, i) => (
        <button
          type="button"
          class={`past-themes-dot${i === 0 ? " is-active" : ""}`}
          data-stop={i}
          aria-label={`テーマ一覧の位置 ${i + 1} / ${totalDots} へ移動`}
          aria-pressed={i === 0 ? "true" : "false"}
        />
      ))}
    </div>
  </div>
</div>
