                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <path
                  d="M46 64 Q51 63 54 61"
                  stroke="#10265B"
                  stroke-width="2.25"
                  stroke-linecap="round"
                />
                <path
                  d="M15 30 A26 26 0 0 1 48 12"
                  stroke="#FFFFFF"
                  stroke-width="2"
                  stroke-linecap="round"
                />
                <circle cx="41" cy="60.5" r="2.25" fill="#10265B" />
                <circle cx="40.4" cy="59.9" r="0.7" fill="#FFFFFF" />
                <ellipse cx="37.5" cy="64" rx="2.5" ry="1.35" fill="#FF8F85" />
              </svg>
            )}
            {theme.icon === "extinction" && (
              <svg viewBox="0 0 80 80" width="80" height="80" fill="none">
                <path
                  d="M52 17 L64 24"
                  stroke="#FFD447"
                  stroke-width="3"
                  stroke-linecap="round"
                />
                <circle cx="51" cy="16" r="3.5" fill="#FF8F85" stroke="#10265B" stroke-width="2" />
                <path
                  d="M20 57 C20 50 25 46 31 46 H41 V30 C41 25 45 22 50 22 H55 C57 22 58 24 58 26 C58 29 55 31 52 31 H48 V48 C48 53 45 57 40 57 V63 H35 V57 H29 V63 H24 V57 Z"
                  fill="#7FDCC3"
                  stroke="#10265B"
                  stroke-width="2.6"
                  stroke-linejoin="round"
                />
                <circle cx="52" cy="26" r="1.4" fill="#10265B" />
              </svg>
            )}
            {theme.icon === "deception" && (
              <svg viewBox="0 0 80 80" width="80" height="80" fill="none">
                <rect
                  x="19"
                  y="22"
                  width="26"
                  height="36"
                  rx="4"
                  transform="rotate(-12 32 40)"
                  fill="#8ECBFF"
                  stroke="#10265B"
                  stroke-width="2.75"
                />
                <rect
                  x="33"
                  y="21"
                  width="26"
                  height="36"
                  rx="4"
                  transform="rotate(8 46 39)"
                  fill="#FFFFFF"
                  stroke="#10265B"
