                    fill="#FFD447"
                  />
                  <path
                    d="M44 64 V61 C44 54 49 50 56 50 H57 C64 50 69 54 69 61 V64 Z"
                    fill="#8ECBFF"
                  />
                  <circle cx="23.5" cy="41" r="9.5" fill="#FFF8E4" />
                  <circle cx="56.5" cy="41" r="9.5" fill="#FFF8E4" />
                </g>
                <circle cx="26.5" cy="40" r="1.4" fill="#10265B" />
                <circle cx="53.5" cy="40" r="1.4" fill="#10265B" />
