          </div>
        </li>
        );
      })}
    </ol>
  </div>

  <div class="past-themes-footer">
    <div
      class="past-themes-dots"
      role="group"
      aria-label={isEn ? "Past themes slide controls" : "過去のテーマの表示位置"}
    >
      {Array.from({ length: totalDots }, (_, i) => (
        <button
          type="button"
          class={`past-themes-dot${i === 0 ? " is-active" : ""}`}
          data-stop={i}
          aria-label={isEn
            ? `Go to theme group ${i + 1} of ${totalDots}`
            : `テーマ一覧の位置 ${i + 1} / ${totalDots} へ移動`}
          aria-pressed={i === 0 ? "true" : "false"}
        />
      ))}
    </div>
  </div>
</div>
