    top: 0.5rem;
    right: 0.5rem;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 0.375rem;
    background: #fff;
    color: inherit;
    font-size: 1.25rem;
    cursor: pointer;
  }

  .access-map button:focus-visible {
    outline: 3px solid #1768e8;
    outline-offset: 2px;
  }
</style>
