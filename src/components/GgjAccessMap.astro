<section id="access" class="section access-map" aria-labelledby="access-title">
  <h2 id="access-title">アクセス</h2>
  <div class="access-layout">
    <div class="map-surface" data-view="overview">
      <div class="map-scene scene-overview" aria-hidden="true">
        <canvas
          class="terrain terrain-overview"
          width="960"
          height="640"
        ></canvas>
        <canvas class="sea-layer" width="960" height="640"></canvas>
        <svg
          class="route-layer"
          viewBox="0 0 960 640"
          preserveAspectRatio="none"
        ></svg>
      </div>
      <div class="map-scene scene-local" aria-hidden="true">
        <canvas class="terrain terrain-local" width="960" height="640"></canvas>
        <canvas class="sea-layer" width="960" height="640"></canvas>
        <svg
          class="route-layer"
          viewBox="0 0 960 640"
          preserveAspectRatio="none"
        ></svg>
      </div>
      <div class="map-markers"></div>
      <button
        class="map-back ggj-arrow-button"
        type="button"
        aria-label="広島市周辺に戻る"
        hidden
      >
        ‹
      </button>
      <div class="map-compass" aria-hidden="true">
        <span>N</span>
        <span class="compass-needle"></span>
      </div>
      <span class="map-credit">
        <a href="https://www.openstreetmap.org/copyright">
          © OpenStreetMap contributors
        </a>
        / 国土地理院
      </span>
    </div>
    <aside id="access-spot" class="spot-panel" aria-label="スポット解説" hidden>
      <button
        class="spot-close"
        type="button"
        aria-label="スポット解説を閉じる"
      >
        ×
      </button>
      <div role="status" aria-atomic="true">
        <h3 class="spot-name"></h3>
        <p class="spot-copy"></p>
        <div class="spot-routes" hidden>
          <ul class="route-times"></ul>
        </div>
      </div>
    </aside>
  </div>
</section>

<script src="../scripts/ggj27-access-map.js"></script>

<style>
  .section.access-map {
    color: #10265b;
    padding: 0.75rem 1rem 1.25rem;
  }

  #access-title {
    max-width: 1192px;
    margin: 0 auto 0.75rem;
  }

  .access-layout {
    position: relative;
    max-width: 90rem;
    margin-inline: auto;
  }

  @media (min-width: 801px) {
    :global(#faq:has(+ #access)) {
      padding-bottom: clamp(1.25rem, 3vw, 2.75rem);
    }

    :global(#access + #mc) {
      padding-top: clamp(1.5rem, 3vw, 2.75rem);
    }
  }

  .map-surface {
    position: relative;
    isolation: isolate;
    height: clamp(310px, 37vw, 540px);
    overflow: hidden;
    border-radius: 0.75rem;
    background: #1d9ab0;
    --travel: 640ms cubic-bezier(0.25, 0.78, 0.3, 1);
  }

  @media (max-width: 800px) {
    .section.access-map {
      padding-block: 1.5rem 1.75rem;
    }

    #access-title {
      margin-left: 0.25rem;
    }

    .map-surface {
      height: auto;
      aspect-ratio: 4 / 3;
    }
  }

  .map-scene {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--terrain-height, 100%);
    transform-origin: top left;
    pointer-events: none;
  }

  .map-scene canvas,
  .route-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }

  .route-layer :global(path) {
    fill: none;
    stroke: #1775ce;
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 1px #10265b);
    stroke-dasharray: 1;
    animation: draw-route 560ms ease-out var(--route-delay) backwards;
  }

  .route-layer :global(path[data-mode="rail"]) {
    stroke: #007454;
  }

  .route-layer :global(path[data-mode="walk"]) {
    stroke: #ffdc54;
  }

  @keyframes draw-route {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .map-surface[data-animating] .map-scene {
    transition:
      transform var(--travel),
      opacity var(--travel);
  }

  .scene-local,
  .map-surface[data-view="local"] .scene-overview {
    opacity: 0;
  }

  .map-surface[data-view="local"] .scene-local {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .map-surface {
      --travel: 0ms;
    }

    .route-layer :global(path) {
      animation: none;
    }
  }

  .map-markers {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .map-surface :global(.map-marker) {
    --pin-size: clamp(17px, 3vw, 32px);
    --pin-height: calc(var(--pin-size) * 1.21);
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    padding: 0;
    color: inherit;
    background: transparent;
    border: 0;
    cursor: pointer;
    pointer-events: auto;
    transform: translate(-50%, -100%);
  }

  .map-surface :global(.map-marker[data-position="below"]) {
    flex-direction: column-reverse;
    transform: translate(-50%, calc(-1 * var(--pin-height)));
  }

  .map-surface :global(.map-marker[data-position="left"]) {
    flex-direction: row;
    transform: translate(calc(-100% + var(--pin-size) / 2), -100%);
  }

  .map-surface :global(.map-marker[data-position="right"]) {
    flex-direction: row-reverse;
    transform: translate(calc(-1 * var(--pin-size) / 2), -100%);
  }

  .map-surface :global(.marker-label) {
    padding: 1px 4px;
    border: 1px solid #10265b;
    border-radius: 4px;
    background: #fff;
    font-family: inherit;
    font-size: clamp(0.6rem, 1.25vw, 0.875rem);
    font-weight: 800;
    line-height: 1.3;
    white-space: nowrap;
  }

  .map-surface :global(.marker-pin) {
    position: relative;
    width: var(--pin-size);
    height: var(--pin-height);
    flex-shrink: 0;
  }

  .map-surface :global(.marker-pin::before) {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    box-sizing: border-box;
    height: var(--pin-size);
    border: 1.5px solid #10265b;
    border-radius: 50% 50% 0 50%;
    background: #fff;
    transform: rotate(45deg);
  }

  .map-surface :global(.marker-pin img) {
    position: absolute;
    top: calc(var(--pin-size) / 2);
    left: 50%;
    width: 88%;
    transform: translate(-50%, -50%);
    image-rendering: pixelated;
  }

  .map-surface :global(.map-marker[aria-pressed="true"] .marker-label),
  .map-surface :global(.map-marker:hover .marker-label) {
    background: #ffd447;
  }

  .map-compass,
  .map-credit {
    position: absolute;
    color: #fff;
    background: #10265b;
  }

  .map-compass {
    right: 8px;
    bottom: 8px;
    display: grid;
    justify-items: center;
    gap: 2px;
    padding: 4px 6px;
    border: 2px solid #fff;
    border-radius: 2px;
    font: bold 10px/1 monospace;
    pointer-events: none;
  }

  .compass-needle {
    width: 18px;
    height: 18px;
    background: linear-gradient(#ff625e 50%, #fff 50%);
    clip-path: polygon(
      44% 0,
      56% 0,
      56% 22%,
      67% 22%,
      67% 39%,
      78% 39%,
      78% 61%,
      67% 61%,
      67% 78%,
      56% 78%,
      56% 100%,
      44% 100%,
      44% 78%,
      33% 78%,
      33% 61%,
      22% 61%,
      22% 39%,
      33% 39%,
      33% 22%,
      44% 22%
    );
  }

  @media (max-width: 480px) {
    .map-compass {
      right: 5px;
      bottom: 5px;
      gap: 1px;
      padding: 2px;
      border-width: 1px;
      font-size: 8px;
    }

    .compass-needle {
      width: 10px;
      height: 10px;
    }

    .map-surface :global(.map-marker[data-spot="hiroshima"]) {
      gap: 7px;
    }
  }

  .map-back {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 0;
  }

  @media (max-width: 360px) {
    .map-back {
      top: 4px;
      left: 4px;
    }

    .map-surface :global(.map-marker[data-spot="hiroshima"]) {
      gap: 10px;
    }

    .map-surface :global(.map-marker[data-spot="busCenter"] .marker-label) {
      translate: 0 -3px;
    }

    .map-surface :global(.map-marker[data-spot="campus"]) {
      margin-top: 4px;
    }
  }

  .map-credit {
    left: 4px;
    bottom: 4px;
    padding: 2px 5px;
    border-radius: 4px;
    font-size: clamp(0.55rem, 1.1vw, 0.7rem);
  }

  .map-credit a {
    color: inherit;
  }

  .spot-panel {
    position: absolute;
    right: 1rem;
    bottom: 3.5rem;
    z-index: 2;
    box-sizing: border-box;
    width: min(20rem, 39%);
    padding: 1.125rem;
    border: 1px solid #d9e5f2;
    border-top: 4px solid #ffd447;
    border-radius: 0.75rem;
    background: #f8fbfff5;
    box-shadow: 0 8px 28px #10265b40;
  }

  .spot-panel[data-side="left"] {
    left: 1rem;
    right: auto;
    bottom: 1.75rem;
  }

  @media (max-width: 800px) {
    .spot-panel,
    .spot-panel[data-side="left"] {
      position: fixed;
      inset: auto 0 0;
      z-index: 31;
      width: 100%;
      max-height: min(50dvh, 22rem);
      overflow: auto;
      padding-bottom: calc(1.125rem + env(safe-area-inset-bottom));
      border-radius: 1rem 1rem 0 0;
    }

    .spot-panel:not([hidden]) {
      animation: spot-rise 280ms cubic-bezier(0.22, 0.75, 0.2, 1) both;
    }
  }

  @keyframes spot-rise {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spot-panel:not([hidden]) {
      animation: none;
    }
  }

  .spot-name {
    margin: 0;
    padding-right: 2rem;
    font-size: 1.125rem;
    line-height: 1.4;
  }

  .spot-copy {
    margin: 0.625rem 0 0;
    color: #465b7a;
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .spot-routes {
    margin-top: 0.75rem;
    color: #465b7a;
  }

  .route-times {
    display: grid;
    gap: 0.5rem;
    margin: 0 0 0.375rem;
    padding: 0;
    list-style: none;
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .route-times :global(li) {
    padding-left: 0.5rem;
    border-left: 3px solid #007454;
  }

  .route-times :global(li[data-mode="bus"]),
  .route-times :global(li[data-mode="ferry"]) {
    border-color: #1775ce;
  }

  .route-times :global(strong) {
    display: block;
    color: #10265b;
  }

  .spot-close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 0.375rem;
    background: #fff;
    color: inherit;
    font-size: 1.25rem;
    cursor: pointer;
  }

  .access-map button:focus-visible {
    outline: 3px solid #1768e8;
    outline-offset: 2px;
  }
</style>
