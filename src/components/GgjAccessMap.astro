      56% 22%,
      67% 22%,
      67% 39%,
      78% 39%,
      78% 61%,
      67% 61%,
      67% 78%,
      56% 78%,
      56% 100%,
      44% 100%,
      44% 78%,
      33% 78%,
      33% 61%,
      22% 61%,
      22% 39%,
      33% 39%,
      33% 22%,
      44% 22%
    );
  }

  @media (max-width: 480px) {
    .map-compass {
