    top: 0;
    left: 0;
    width: 100%;
    height: var(--terrain-height, 100%);
    transform-origin: top left;
    image-rendering: pixelated;
  }

  .map-surface[data-animating] .terrain {
    transition:
      transform var(--travel),
      opacity var(--travel);
  }

  .terrain-local,
  .map-surface[data-view="local"] .terrain-overview {
    opacity: 0;
  }

  .map-surface[data-view="local"] .terrain-local {
