---
interface Props {
  entries: { id?: string; question: string; answer: string }[];
  language: "ja" | "en";
}

const { entries, language } = Astro.props;
const siteURL = Astro.site ?? new URL("https://hiro-uni.github.io/");
const pageURL = new URL(language === "en" ? "/ggj/en/" : "/ggj/", siteURL);

/** Normalize FAQ answer HTML for JSON-LD: strip screen-reader labels and absolutize links. */
function sanitizeAnswerForJsonLd(html: string): string {
  return html
    .replace(/<span\s+class="sr-only"[^>]*>[\s\S]*?<\/span>/g, "")
    .replace(
      /\bhref="((?:\/|#)[^"]*)"/g,
      (_, href: string) => `href="${new URL(href, pageURL).href}"`,
    )
    .replace(/\s+/g, " ")
    .trim();
}

const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  url: pageURL.href,
  inLanguage: language,
  mainEntity: entries.map(({ question, answer }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: {
      "@type": "Answer",
      text: sanitizeAnswerForJsonLd(answer),
    },
  })),
};
---

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(faqData).replaceAll("<", "\\u003c")}
/>
<div class="faq-list">
  {
    entries.map(({ id, question, answer }) => (
      <details id={id}>
        <summary>
          {question}
          <span class="faq-toggle" aria-hidden="true">
            <i class="fa-solid fa-plus"></i>
            <i class="fa-solid fa-minus"></i>
          </span>
        </summary>
        <Fragment set:html={answer} />
      </details>
    ))
  }
</div>

<style>
  .faq-toggle {
    color: var(--blue);
    flex: none;
    width: 1em;
    line-height: 1;
    text-align: center;
  }

  details:not([open]) .fa-minus,
  details[open] .fa-plus {
    display: none;
  }
</style>
