---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  category: string;
  date: string;
  heroImage: ImageMetadata;
  heroAlt: string;
}

const { title, category, date, heroImage, heroAlt } = Astro.props;
---

<header class="interview-header">
  <div class="category">{category}</div>
  <div class="meta">
    <time datetime={date}>{date}</time>
  </div>
  <div class="hero">
    <Image
      src={heroImage}
      alt={heroAlt}
      widths={[640, 960, 1280]}
      sizes="(max-width: 768px) 100vw, 960px"
      loading="eager"
    />
  </div>
</header>

<style>
  .interview-header {
    margin-bottom: 3rem;
    text-align: center;
  }

  .category {
    display: inline-block;
    background: var(--primary, #000);
    color: #fff;
    padding: 2px 12px;
    font-size: 0.8rem;
    font-weight: bold;
    margin-bottom: 1rem;
    letter-spacing: 0.1em;
  }

  .meta {
    font-size: 0.9rem;
    color: #666;
    margin-bottom: 2rem;
  }

  .hero {
    margin: 0 -20px;
  }

  .hero img {
    width: 100%;
    height: auto;
    display: block;
    max-height: 600px;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .title {
      font-size: 1.8rem;
    }
  }
</style>
