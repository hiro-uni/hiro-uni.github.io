---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  pubDate?: Date;
  articleJsonLd?: boolean;
  author?: string;
  noindex?: boolean;
}

const {
  title = "広島Unity勉強会",
  description = "広島で活動するUnityユーザーのためのコミュニティ、広島Unity勉強会の公式サイトです。",
  ogImage = "/hirouni.png",
  pubDate,
  articleJsonLd = false,
  author,
  noindex = false,
} = Astro.props;

const siteURL = Astro.site ?? new URL("https://hiro-uni.github.io/");
const siteName = "広島Unity勉強会";
const documentTitle = title.includes(siteName)
  ? title
  : `${title} - ${siteName}`;
// Match directory URLs served by GitHub Pages and emitted in the sitemap.
const canonicalPath = `${Astro.url.pathname.replace(/\/+$/, "")}/`;
const canonicalURL = new URL(canonicalPath, siteURL);
const imageURL = new URL(ogImage, siteURL);
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrentPage = (path: string) =>
  currentPath === path || (path !== "/" && currentPath.startsWith(`${path}/`));

// JSON-LD Schemas
const schemas = [];

// Base Organization Schema
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "広島Unity勉強会",
  alternateName: "Hiroshima Unity Study Group",
  url: siteURL.href,
  logo: new URL("/hirouni.png", siteURL).href,
  sameAs: ["https://hirouni.connpass.com/"],
};

// Base WebSite Schema
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "広島Unity勉強会",
  url: siteURL.href,
};

if (Astro.url.pathname === "/" || Astro.url.pathname === "") {
  schemas.push(organizationSchema);
  schemas.push(websiteSchema);
} else {
  // For other pages, we can also link back to organization
  schemas.push({
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description: description,
    url: canonicalURL.toString(),
    isPartOf: {
      "@type": "WebSite",
      name: "広島Unity勉強会",
      url: siteURL.href,
    },
  });
}

if (articleJsonLd) {
  const articleSchema = {
    "@context": "https://schema.org",
    "@type": currentPath.startsWith("/news/") ? "NewsArticle" : "Article",
    "@id": `${canonicalURL.href}#article`,
    url: canonicalURL.href,
    mainEntityOfPage: { "@type": "WebPage", "@id": canonicalURL.href },
    inLanguage: "ja",
    headline: title,
    image: [imageURL.href],
    datePublished: pubDate?.toISOString(),
    author:
      author && author !== siteName
        ? { "@type": "Person", name: author }
        : {
            "@type": "Organization",
            name: siteName,
            url: siteURL.href,
          },
    publisher: {
      "@type": "Organization",
      name: "広島Unity勉強会",
      logo: {
        "@type": "ImageObject",
        url: new URL("/hirouni.png", siteURL).href,
      },
    },
    description: description,
  };
  schemas.push(articleSchema);
}
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="google-site-verification"
      content="H29i6_QX8KTq9pqelrSH4lJ15fO52n0W3sfD5qaj8R8"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
      integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- OGP -->
    <meta property="og:title" content={documentTitle} />
    <meta property="og:type" content={articleJsonLd ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:site_name" content="広島Unity勉強会" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="description" content={description} />
    <meta property="og:description" content={description} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={title} />
    {articleJsonLd && pubDate && (
      <meta property="article:published_time" content={pubDate.toISOString()} />
    )}

    <title>{documentTitle}</title>

    {!noindex &&
      schemas.map((schema) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
        />
      ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      本文へスキップ
    </a>
    <div id="redirect-banner" class="redirect-banner" style="display: none;">
      <div class="container banner-inner">
        <span class="banner-text">
          <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
          広島Unity勉強会 Webサイト
          のURLが変更となりました。ブックマークやリンクの変更をお願いします。
          <button id="copy-url-btn" class="copy-url-btn" title="URLをコピー">
            <i class="fa-regular fa-copy" aria-hidden="true"></i> URLをコピー
          </button>
        </span>
        <button
          id="close-redirect-banner"
          class="banner-close"
          aria-label="閉じる"
        >
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
      </div>
    </div>
    <p id="copy-url-status" class="sr-only" role="status"></p>

    <script is:inline>
      (function () {
        const banner = document.getElementById("redirect-banner");
        const closeBtn = document.getElementById("close-redirect-banner");
        const copyBtn = document.getElementById("copy-url-btn");
        const copyStatus = document.getElementById("copy-url-status");
        if (!banner || !closeBtn) return;

        const isDismissed = sessionStorage.getItem("redirect-banner-dismissed");
        if (isDismissed) return;

        const referrer = document.referrer || "";
        const urlParams = new URLSearchParams(window.location.search);
        const isFromJimdo =
          referrer.includes("hiroshima-unity.jimdofree.com") ||
          urlParams.has("redirected");

        if (isFromJimdo) {
          banner.style.display = "block";
          closeBtn.addEventListener("click", function () {
            banner.style.display = "none";
            document.querySelector(".logo-link")?.focus();
            sessionStorage.setItem("redirect-banner-dismissed", "true");
          });
        }

        if (copyBtn) {
          copyBtn.addEventListener("click", function () {
            navigator.clipboard
              .writeText("https://hiro-uni.github.io")
              .then(() => {
                const origHTML = copyBtn.innerHTML;
                copyBtn.innerHTML =
                  '<i class="fa-solid fa-check" aria-hidden="true"></i> コピーしました';
                if (copyStatus)
                  copyStatus.textContent = "URLをコピーしました。";
                copyBtn.classList.add("copied");
                setTimeout(() => {
                  copyBtn.innerHTML = origHTML;
                  copyBtn.classList.remove("copied");
                }, 2000);
              })
              .catch((err) => {
                console.error("Failed to copy: ", err);
                if (copyStatus)
                  copyStatus.textContent =
                    "コピーできませんでした。ブラウザーのアドレス欄からURLをコピーしてください。";
              });
          });
        }
      })();
    </script>

    <header>
      <div class="container">
        <a href="/" class="logo-link">
          <img src="/hirouni.png" alt="広島Unity勉強会" class="header-logo" />
        </a>
        <nav aria-label="メインナビゲーション">
          <ul>
            <li>
              <a
                href="/"
                aria-current={isCurrentPage("/") ? "page" : undefined}
              >
                ホーム
              </a>
            </li>
            <li>
              <a
                href="/news/"
                aria-current={isCurrentPage("/news") ? "page" : undefined}
              >
                ニュース
              </a>
            </li>
            <li>
              <a
                href="/about/"
                aria-current={isCurrentPage("/about") ? "page" : undefined}
              >
                活動について
              </a>
            </li>
            <li>
              <a
                href="/mokumoku/"
                aria-current={isCurrentPage("/mokumoku") ? "page" : undefined}
              >
                もくもく会
              </a>
            </li>
            <li>
              <a
                href="/contact/"
                aria-current={isCurrentPage("/contact") ? "page" : undefined}
              >
                お問い合わせ
              </a>
            </li>
            <li>
              <a
                href="/ggj/"
                aria-current={isCurrentPage("/ggj") ? "page" : undefined}
              >
                GGJ 2027
              </a>
            </li>
            <li>
              <a
                href="/interview/"
                aria-current={isCurrentPage("/interview") ? "page" : undefined}
              >
                インタビュー
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main-content" class="container" tabindex="-1">
      <h1 class="page-title">{title}</h1>
      <slot />
    </main>

    <footer>
      <div class="container">
        <p>&copy; 2014-2026 広島Unity勉強会</p>
        <p>
          <small>
            広島Unity勉強会 は Unity Technologies社、Unity Japan
            およびその関連団体とは何ら関係はありません。
          </small>
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --primary: #ffffffff;
    --secondary: #b30b54ff;
    --accent: #176b9e;
    --text: #333;
    --bg: #f8f9fa;
    --white: #ffffff;
    --container-width: 960px;
  }

  * {
    box-sizing: border-box;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--white);
    color: var(--text);
    font-weight: bold;
    transform: translateY(calc(-100% - 1rem));
  }

  .skip-link:focus {
    transform: none;
  }

  :where(a, button, input, select, textarea, summary):focus-visible {
    outline: 3px solid #183432;
    outline-offset: 4px;
    box-shadow: 0 0 0 4px #fff;
  }

  #main-content:focus {
    outline: none;
  }

  img,
  video,
  iframe {
    max-width: 100%;
  }

  main {
    overflow-wrap: anywhere;
  }

  body {
    font-family:
      "Helvetica Neue", Arial, "Hiragino Kaku Gothic ProN", "Hiragino Sans",
      Meiryo, sans-serif;
    line-height: 1.6;
    color: var(--text);
    background-color: var(--bg);
    margin: 0;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .redirect-banner {
    background-color: #fff3cd;
    color: #856404;
    border-bottom: 1px solid #ffeeba;
    padding: 0.75rem 0;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .banner-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .banner-text {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-align: left;
    flex-wrap: wrap;
  }

  .copy-url-btn {
    min-height: 44px;
    background-color: #ffffff;
    border: 1px solid #c8a332;
    color: #856404;
    border-radius: 4px;
    padding: 0.25rem 0.6rem;
    font-size: 0.75rem;
    font-weight: bold;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: all 0.2s ease;
    margin-left: 0.5rem;
  }

  .copy-url-btn:hover {
    background-color: #ffeeba;
    border-color: #856404;
  }

  .copy-url-btn.copied {
    background-color: #d4edda;
    border-color: #c3e6cb;
    color: #155724;
  }

  .banner-close {
    min-width: 44px;
    min-height: 44px;
    background: none;
    border: none;
    color: #856404;
    cursor: pointer;
    font-size: 1.2rem;
    padding: 0 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .banner-close:hover {
    opacity: 1;
  }

  .container {
    width: 100%;
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 20px;
  }

  header {
    background-color: var(--white);
    color: var(--text);
    padding: 1.5rem 0;
    border-bottom: 1px solid #eee;
  }

  header .container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .logo-link {
    display: block;
    margin-bottom: 0.5rem;
  }

  .header-logo {
    height: 90px;
    width: auto;
    display: block;
  }

  nav {
    width: 100%;
  }

  nav ul {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text);
    text-decoration: none;
    font-weight: bold;
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  nav a:hover {
    color: var(--secondary);
    text-decoration: none;
  }

  header nav a[aria-current="page"] {
    color: var(--secondary);
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 2px;
  }

  main {
    flex: 1;
    padding: 2rem 20px 4rem;
    background-color: var(--white);
    margin-top: 2rem;
    margin-bottom: 2rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    border-radius: 8px;
  }

  .page-title {
    font-size: 2.2rem;
    color: var(--text);
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 4px solid var(--secondary);
    line-height: 1.2;
    font-weight: 800;
  }

  footer {
    background-color: var(--secondary);
    color: var(--white);
    text-align: center;
    padding: 2rem 0;
    margin-top: auto;
  }

  h2 {
    border-bottom: 2px solid var(--accent);
    padding-bottom: 0.5rem;
    margin-top: 2rem;
  }

  h3 {
    margin-top: 1.5rem;
  }

  a {
    color: var(--accent);
  }

  @media (max-width: 600px) {
    nav ul {
      gap: 1rem;
    }
    header h1 {
      text-align: center;
    }
    nav ul {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      animation: none !important;
      transition: none !important;
    }
  }
</style>
